# Umami Cloud website ID (Settings → Websites → your site → ID on umami.is).
# Not secret — it ends up in the page source either way. Set the real value
# in Cloudflare Pages → Settings → Environment variables for production.
PUBLIC_UMAMI_WEBSITE_ID=

# Meta (Facebook/Instagram) Ads Pixel ID (Events Manager → Data Sources →
# your pixel → ID, a numeric string). Not secret. Set the real value in
# Cloudflare Pages → Settings → Environment variables for production.
PUBLIC_META_PIXEL_ID=

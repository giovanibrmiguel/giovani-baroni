---
/**
 * DiscographySection
 * Full-width vertical list of releases. One release per row.
 * Each row: square cover (left) + metadata/description/link (right).
 */
import type { Release } from "@/data/releases";
import { resolveBluTrackHref } from "@/data/bluWorld";
import { platformIconSvg, PLATFORM_LABEL, type PlatformKey } from "@/data/platformIcons";

const platformKeys: PlatformKey[] = ["spotify", "youtubeMusic", "appleMusic", "amazonMusic", "deezer"];
const platformLinks = platformKeys.map((key) => ({
  key,
  ...PLATFORM_LABEL[key],
  icon: platformIconSvg(key, 11),
}));

interface Props {
  releases: Release[];
}

const { releases } = Astro.props;

const typeLabel: Record<Release["type"], string> = {
  album: "Album",
  ep: "EP",
  single: "Single",
  live: "Live",
  compilation: "Compilation",
};
---

<section id="discography" class="py-16 md:py-24 border-t border-ocean-900" aria-labelledby="discography-heading">
  <div class="max-w-4xl mx-auto px-6">
    <p class="label-mono text-lg text-ocean-500 mb-12" id="discography-heading">
      discography
    </p>

    <div class="space-y-12 md:space-y-16">
      {
        releases.map((release) => (
          <article class="grid grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
            <!-- Cover image -->
            <div class="w-28 h-28 md:w-40 md:h-40 flex-shrink-0 rounded-sm overflow-hidden bg-ocean-900 border border-ocean-800">
              {release.project === "blu" ? (
                <a href="/blu" aria-label={`View ${release.title} page`}>
                  <img
                    src={release.coverImage}
                    alt={`${release.title} cover`}
                    class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-300"
                    loading="lazy"
                    width="160"
                    height="160"
                    onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
                  />
                </a>
              ) : release.project === "mecanicadosfluidos" ? (
                <a href="/mecanicadosfluidos" aria-label={`View ${release.title} page`}>
                  <img
                    src={release.coverImage}
                    alt={`${release.title} cover`}
                    class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-300"
                    loading="lazy"
                    width="160"
                    height="160"
                    onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
                  />
                </a>
              ) : release.project === "fishyboy" ? (
                <a href="/fishyboy" aria-label={`View ${release.title} page`}>
                  <img
                    src={release.coverImage}
                    alt={`${release.title} cover`}
                    class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-300"
                    loading="lazy"
                    width="160"
                    height="160"
                    onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
                  />
                </a>
              ) : (
                <img
                  src={release.coverImage}
                  alt={`${release.title} cover`}
                  class="w-full h-full object-cover opacity-90"
                  loading="lazy"
                  width="160"
                  height="160"
                  onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
                />
              )}
            </div>

            <!-- Info -->
            <div class="space-y-3 min-w-0 pt-1">
              <!-- Title -->
              <div>
                <h3 class="font-display text-foam text-lg md:text-xl leading-tight">
                  {release.project === "blu" ? (
                    <a href="/blu" class="hover:text-ocean-200 transition-colors duration-200">
                      {release.title}
                    </a>
                  ) : release.project === "mecanicadosfluidos" ? (
                    <a href="/mecanicadosfluidos" class="hover:text-ocean-200 transition-colors duration-200">
                      {release.title}
                    </a>
                  ) : release.project === "fishyboy" ? (
                    <a href="/fishyboy" class="hover:text-ocean-200 transition-colors duration-200">
                      {release.title}
                    </a>
                  ) : (
                    release.title
                  )}
                </h3>
                <p class="label-mono text-base text-ocean-500 mt-1">
                  {release.projectDisplayName}
                </p>
              </div>

              <!-- Meta row -->
              <div class="flex flex-wrap items-center gap-3">
                <span class="label-mono text-base text-ocean-400 border border-ocean-800 px-2 py-0.5 rounded-sm">
                  {typeLabel[release.type]}
                </span>
                <span class="label-mono text-base text-ocean-600">
                  {release.year}
                </span>
              </div>

              <!-- Short description (language-toggled) -->
              {release.shortDescription && (
                <p class="lang-en text-ocean-300 text-base leading-relaxed max-w-lg">
                  {release.shortDescription}
                </p>
              )}
              {release.shortDescriptionPt && (
                <p class="lang-pt text-ocean-300 text-base leading-relaxed max-w-lg">
                  {release.shortDescriptionPt}
                </p>
              )}
              {release.shortDescriptionEs && (
                <p class="lang-es text-ocean-300 text-base leading-relaxed max-w-lg">
                  {release.shortDescriptionEs}
                </p>
              )}

              <!-- Tracklist -->
              {release.tracklist && release.tracklist.length > 0 && (
                <ol class="space-y-1 pt-1">
                  {release.tracklist.map((track) => {
                    const href =
                      release.project === "blu" ? resolveBluTrackHref(track) : null;
                    return (
                      <li
                        class:list={[
                          "text-sm font-mono",
                          href ? "text-ocean-300" : "text-ocean-600",
                        ]}
                      >
                        {href ? (
                          <a
                            href={href}
                            class="group inline-flex items-center gap-1.5 hover:text-foam transition-colors duration-200"
                          >
                            <span>{track}</span>
                            <span
                              class="text-ocean-600 group-hover:text-ocean-400 transition-colors duration-200"
                              aria-hidden="true"
                            >→</span>
                          </a>
                        ) : (
                          <span>{track}</span>
                        )}
                      </li>
                    );
                  })}
                </ol>
              )}

              <!-- Links -->
              <div class="flex flex-col gap-2 pt-1">
                {release.project === "blu" && (
                  <div>
                    <a
                      href="/blu"
                      class="inline-block label-mono text-sm bg-crimson-700 hover:bg-crimson-500 text-foam border border-crimson-500 hover:border-crimson-400 px-4 py-2 rounded-sm transition-all duration-200"
                    >
                      <span class="lang-en">more stuff about bLU →</span>
                      <span class="lang-pt">mais sobre bLU →</span>
                      <span class="lang-es">más sobre bLU →</span>
                    </a>
                  </div>
                )}
                {release.project === "mecanicadosfluidos" && (
                  <div>
                    <a
                      href="/mecanicadosfluidos"
                      class="inline-block label-mono text-sm bg-ocean-800 hover:bg-ocean-700 text-foam border border-ocean-600 hover:border-ocean-400 px-4 py-2 rounded-sm transition-all duration-200"
                    >
                      <span class="lang-en">more stuff about mecânica dos fluidos →</span>
                      <span class="lang-pt">mais sobre mecânica dos fluidos →</span>
                      <span class="lang-es">más sobre mecânica dos fluidos →</span>
                    </a>
                  </div>
                )}
                {release.project === "fishyboy" && (
                  <div>
                    <a
                      href="/fishyboy"
                      class="inline-block label-mono text-sm bg-ocean-800 hover:bg-ocean-700 text-foam border border-ocean-600 hover:border-ocean-400 px-4 py-2 rounded-sm transition-all duration-200"
                    >
                      <span class="lang-en">more stuff about fishy boy →</span>
                      <span class="lang-pt">mais sobre fishy boy →</span>
                      <span class="lang-es">más sobre fishy boy →</span>
                    </a>
                  </div>
                )}
                <!-- Streaming buttons -->
                <div class="flex flex-wrap gap-2">
                  {platformLinks.map(({ key, label, line2, icon }) => {
                    const url = release.links?.[key];
                    const inner = (
                      <>
                        <span set:html={icon} />
                        <span class="flex flex-col leading-tight text-center">
                          <span>{label}</span>
                          {line2 && <span>{line2}</span>}
                        </span>
                      </>
                    );
                    return url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-2.5 py-1.5 rounded-sm transition-all duration-200"
                      >
                        <span set:html={icon} />
                        <span class="flex flex-col leading-[1.1] text-left">
                          <span>{label}</span>
                          {line2 && <span>{line2}</span>}
                        </span>
                      </a>
                    ) : (
                      <span class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-700 border border-ocean-900 px-2.5 py-1.5 rounded-sm cursor-not-allowed select-none">
                        <span set:html={icon} />
                        <span class="flex flex-col leading-[1.1] text-left">
                          <span>{label}</span>
                          {line2 && <span>{line2}</span>}
                        </span>
                      </span>
                    );
                  })}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

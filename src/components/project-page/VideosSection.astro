---
/**
 * VideosSection
 * Renders YouTube embeds for a given project.
 *
 * project: "giovani-baroni" → shows GB videos + bLU videos (bLU auto-syncs here)
 *          "sukya-porno"    → shows sukya videos only
 *          "blu"            → shows bLU videos only
 *
 * To add a video: add an entry in src/data/videos.ts
 */
import { videos } from "@/data/videos";

interface Props {
  project: "giovani-baroni" | "sukya-porno" | "blu";
}

const { project } = Astro.props;

// GB page shows its own videos + bLU videos (future bLU videos auto-appear here)
const projectVideos = videos.filter((v) =>
  project === "giovani-baroni"
    ? v.project === "giovani-baroni" || v.project === "blu"
    : v.project === project
);
---

<section id="videos" class="py-16 md:py-24 border-t border-ocean-900" aria-labelledby="videos-heading">
  <div class="max-w-5xl mx-auto px-6">
    <p class="label-mono text-lg text-ocean-500 mb-12" id="videos-heading">
      Videos
    </p>

    {projectVideos.length > 0 ? (
      <div class="flex flex-col gap-10">
        {projectVideos.map((video) => (
          <div class="relative w-full rounded-sm overflow-hidden bg-ocean-900" style="padding-bottom: 56.25%;">
            <div
              class="absolute inset-0 [&>iframe]:w-full [&>iframe]:h-full"
              set:html={video.embedCode}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="card-ocean p-10 text-center">
        <p class="text-ocean-500 label-mono text-base">
          Music videos and live sessions coming soon.
        </p>
      </div>
    )}
  </div>
</section>

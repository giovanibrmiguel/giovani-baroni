---
/**
 * ProjectPage
 * Shared layout component for GIOVANI BARONI and sukya || porno pages.
 * Renders all sections: bio, press kit, discography, videos.
 *
 * The bio content is injected via the "bio" named slot from each project page.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import DiscographySection from "@/components/project-page/DiscographySection.astro";
import VideosSection from "@/components/project-page/VideosSection.astro";
import JsonLd from "@/components/shared/JsonLd.astro";
import { site } from "@/data/site";
import type { ProjectConfig, ProjectKey } from "@/data/site";
import type { Release } from "@/data/releases";

interface Props {
  projectKey: ProjectKey;
  config: ProjectConfig;
  releases: Release[];
  description?: string;
}

const { projectKey, config, releases, description } = Astro.props;

const giovaniSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Giovani Baroni",
  url: site.domain,
  jobTitle: "Musician, Songwriter, Producer",
  description:
    "Brazilian multi-instrumentalist and producer known for prog-influenced indie rock. Fronts the São Paulo band sukya || porno and releases solo work under his own name. Based in Mexico City.",
  genre: ["Indie Rock", "Progressive Rock", "Alternative Rock"],
  sameAs: [
    "https://open.spotify.com/artist/6qme9zfWubX4UWQQV8pVPY",
    "https://www.instagram.com/giovanibaroni/",
    "https://www.youtube.com/@sukyarecords",
  ],
};

const sukyaSchema = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: "sukya || porno",
  url: `${site.domain}/sukya`,
  description:
    "São Paulo alt-rock band with two EPs. Dense, angular, and urban — influenced by Pavement's sloppy grit and the arrangement complexity of King Crimson.",
  genre: ["Alternative Rock", "Indie Rock", "Experimental Rock", "Progressive Rock"],
  foundingLocation: {
    "@type": "Place",
    name: "São Paulo, Brazil",
  },
  member: {
    "@type": "Person",
    name: "Giovani Baroni",
    roleName: "Vocalist, Guitarist",
  },
  sameAs: [
    "https://open.spotify.com/artist/7ndXsfZrZViNKKJB2LWXz5",
    "https://www.instagram.com/sukyap/",
    "https://www.youtube.com/@sukyarecords",
  ],
};
---

<BaseLayout
  title={config.displayName}
  description={description ?? `${config.displayName} — official page.`}
  project={projectKey}
  lang="pt"
>
  <Fragment slot="head">
    {projectKey === "giovani-baroni" && <JsonLd schema={giovaniSchema} />}
    {projectKey === "sukya-porno" && <JsonLd schema={sukyaSchema} />}
  </Fragment>
  <!-- ── bLU CTA banner (GIOVANI BARONI page only) ───────────────── -->
  {projectKey === "giovani-baroni" && (
    <a
      href="/blu"
      class="group flex items-center justify-between gap-4 w-full px-6 py-3
             bg-crimson-700 hover:bg-crimson-500
             border-b border-crimson-500 hover:border-crimson-400
             transition-all duration-300"
      aria-label="bLU — album · 2026"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-0.5 sm:gap-3 min-w-0">
        <span class="label-mono text-xs text-gold tracking-widest shrink-0">2026</span>
        <span class="text-foam text-sm font-semibold tracking-wide">bLU</span>
      </div>
      <span
        class="label-mono text-xs text-gold group-hover:text-foam shrink-0 transition-colors duration-200"
      >→</span>
    </a>
  )}

  <!-- ── Mecânica dos Fluidos CTA banner (GIOVANI BARONI page only) ── -->
  <!-- was: href="/mecanicadosfluidos" -->
  {projectKey === "giovani-baroni" && (
    <a
      href="/listen"
      class="group flex items-center justify-between gap-4 w-full px-6 py-3
             bg-ocean-900 hover:bg-ocean-800
             border-b border-ocean-700 hover:border-ocean-500
             transition-all duration-300"
      aria-label="Mecânica dos Fluidos — bLU · 2026"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-0.5 sm:gap-3 min-w-0">
        <span class="label-mono text-xs text-ocean-400 tracking-widest shrink-0">2026</span>
        <span class="text-ocean-200 text-sm font-semibold tracking-wide">mecânica dos fluidos · bLU</span>
      </div>
      <span
        class="label-mono text-xs text-ocean-400 group-hover:text-foam shrink-0 transition-colors duration-200"
      >→</span>
    </a>
  )}

  <!-- ── Bio section ─────────────────────────────────────────────── -->
  <section id="bio" class="pt-12 pb-0" aria-labelledby="bio-heading">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Project title + portrait row -->
      <div class="grid md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-start mb-12">
        <!-- Left: title, contact -->
        <div>
          <h1
            id="bio-heading"
            class="font-display text-foam text-4xl md:text-6xl leading-none tracking-tight mb-4"
          >
            {config.displayName}
          </h1>
          <a
            href={`mailto:${config.email}`}
            class="label-mono text-lg text-ocean-400 hover:text-ocean-200 transition-colors duration-200"
          >
            {config.email}
          </a>
        </div>

        <!-- Right: portrait -->
        <div class="w-32 h-32 md:w-44 md:h-44 flex-shrink-0 rounded-sm overflow-hidden bg-ocean-900 border border-ocean-800 justify-self-end md:justify-self-auto">
          <img
            src={config.portrait}
            alt={`${config.displayName} portrait`}
            class="w-full h-full object-cover opacity-85"
            loading="eager"
            width="176"
            height="176"
            onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
          />
        </div>
      </div>

      <!-- Bio content (injected by parent page, language-toggled) -->
      <div class="border-t border-ocean-900 pt-10 mb-12">
        <p class="label-mono text-lg text-ocean-500 mb-5">
          <span class="lang-en">about</span>
          <span class="lang-pt">sobre</span>
          <span class="lang-es">sobre</span>
        </p>
        <div class="lang-en prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio" />
        </div>
        <div class="lang-pt prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio-pt" />
        </div>
        <div class="lang-es prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio-es" />
        </div>
      </div>

      <!-- Press Kit -->
      <div id="presskit" class="py-10 border-t border-ocean-900">
        <p class="label-mono text-lg text-ocean-500 mb-5">press kit</p>
        <div class="flex flex-col gap-4">
          <p class="text-ocean-400 text-base">
            <span class="lang-en">Hi-resolution photos, bio, and release info.</span>
            <span class="lang-pt">Fotos em alta resolução, bio e informações de lançamento.</span>
            <span class="lang-es">Fotos en alta resolución, bio e información de lanzamiento.</span>
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={config.pressKitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 whitespace-nowrap"
              style="background:#c0c0c0; color:#000; font-family:'MS Sans Serif',Arial,sans-serif; font-size:0.8rem; letter-spacing:0.05em; padding:4px 10px; border-top:2px solid #fff; border-left:2px solid #fff; border-right:2px solid #808080; border-bottom:2px solid #808080; cursor:pointer; text-decoration:none; width:fit-content;"
              aria-label="Download press kit (opens Google Drive)"
              onmousedown="this.style.borderTop='2px solid #808080';this.style.borderLeft='2px solid #808080';this.style.borderRight='2px solid #fff';this.style.borderBottom='2px solid #fff';"
              onmouseup="this.style.borderTop='2px solid #fff';this.style.borderLeft='2px solid #fff';this.style.borderRight='2px solid #808080';this.style.borderBottom='2px solid #808080';"
            >
              download press-kit
            </a>
            {projectKey === "sukya-porno" && (
              <a
                href="/easter-egg-3"
                class="inline-flex items-center gap-2 whitespace-nowrap"
                style="background:#c0c0c0; color:#000; font-family:'MS Sans Serif',Arial,sans-serif; font-size:0.8rem; letter-spacing:0.05em; padding:4px 10px; border-top:2px solid #fff; border-left:2px solid #fff; border-right:2px solid #808080; border-bottom:2px solid #808080; cursor:pointer; text-decoration:none; width:fit-content;"
                onmousedown="this.style.borderTop='2px solid #808080';this.style.borderLeft='2px solid #808080';this.style.borderRight='2px solid #fff';this.style.borderBottom='2px solid #fff';"
                onmouseup="this.style.borderTop='2px solid #fff';this.style.borderLeft='2px solid #fff';this.style.borderRight='2px solid #808080';this.style.borderBottom='2px solid #808080';"
              >
                I wanna have fun
              </a>
            )}
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Discography ─────────────────────────────────────────────── -->
  <DiscographySection releases={releases} />

  <!-- ── Lyrics / Chords ────────────────────────────────────────── -->
  <section id="lyrics" class="py-16 md:py-24 border-t border-ocean-900" aria-labelledby="lyrics-heading">
    <div class="max-w-4xl mx-auto px-6">
      <p class="label-mono text-lg text-ocean-500 mb-12" id="lyrics-heading">
        <span class="lang-en">lyrics / chords</span>
        <span class="lang-pt">letras / cifras</span>
        <span class="lang-es">letras / cifras</span>
      </p>
      <slot name="lyrics">
        <div class="card-ocean p-10 text-center">
          <p class="text-ocean-500 label-mono text-base">
            <span class="lang-en">Lyrics and chords coming soon.</span>
            <span class="lang-pt">Letras e cifras em breve.</span>
            <span class="lang-es">Letras y cifras próximamente.</span>
          </p>
        </div>
      </slot>
    </div>
  </section>

  <!-- ── Videos ─────────────────────────────────────────────────── -->
  <VideosSection project={projectKey} />

  <!-- ── hidden easter egg ──────────────────────────────────────── -->
  {projectKey === "giovani-baroni" && (
    <div class="flex justify-center px-6 py-4">
      <a
        href="/easter-egg"
        class="inline-flex items-center gap-2 whitespace-nowrap"
        style="background:#c0c0c0; color:#000; font-family:'MS Sans Serif',Arial,sans-serif; font-size:0.75rem; letter-spacing:0.04em; padding:3px 8px; border-top:2px solid #fff; border-left:2px solid #fff; border-right:2px solid #808080; border-bottom:2px solid #808080; cursor:pointer; text-decoration:none; width:fit-content;"
        onmousedown="this.style.borderTop='2px solid #808080';this.style.borderLeft='2px solid #808080';this.style.borderRight='2px solid #fff';this.style.borderBottom='2px solid #fff';"
        onmouseup="this.style.borderTop='2px solid #fff';this.style.borderLeft='2px solid #fff';this.style.borderRight='2px solid #808080';this.style.borderBottom='2px solid #808080';"
      >
        download evil virus
      </a>
    </div>
  )}

</BaseLayout>

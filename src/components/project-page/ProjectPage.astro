---
/**
 * ProjectPage
 * Shared layout component for GIOVANI BARONI and sukya || porno pages.
 * Renders all sections: bio, press kit, discography, videos.
 *
 * The bio content is injected via the "bio" named slot from each project page.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import DiscographySection from "@/components/project-page/DiscographySection.astro";
import VideosSection from "@/components/project-page/VideosSection.astro";
import type { ProjectConfig, ProjectKey } from "@/data/site";
import type { Release } from "@/data/releases";

interface Props {
  projectKey: ProjectKey;
  config: ProjectConfig;
  releases: Release[];
  description?: string;
}

const { projectKey, config, releases, description } = Astro.props;
---

<BaseLayout
  title={config.displayName}
  description={description ?? `${config.displayName} — official page.`}
  project={projectKey}
>
  <!-- ── bLU CTA banner (GIOVANI BARONI page only) ───────────────── -->
  {projectKey === "giovani-baroni" && (
    <a
      href="/blu"
      class="group flex items-center justify-between gap-4 w-full px-6 py-3
             bg-crimson-700 hover:bg-crimson-500
             border-b border-crimson-500 hover:border-crimson-400
             transition-all duration-300"
      aria-label="Explore bLU — debut album"
    >
      <div class="flex items-center gap-3 min-w-0">
        <span class="label-mono text-xs text-gold tracking-widest shrink-0">
          <span class="lang-en">NEW ALBUM</span>
          <span class="lang-pt">NOVO ÁLBUM</span>
          <span class="lang-es">NUEVO ÁLBUM</span>
        </span>
        <span class="text-foam text-sm font-semibold tracking-wide truncate">
          <span class="lang-en">bLU — debut album · 2026</span>
          <span class="lang-pt">bLU — álbum de estreia · 2026</span>
          <span class="lang-es">bLU — álbum debut · 2026</span>
        </span>
      </div>
      <span
        class="label-mono text-xs text-gold group-hover:text-foam shrink-0 transition-colors duration-200"
      >Explore →</span>
    </a>
  )}

  <!-- ── Bio section ─────────────────────────────────────────────── -->
  <section id="bio" class="pt-12 pb-0" aria-labelledby="bio-heading">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Project title + portrait row -->
      <div class="grid md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-start mb-12">
        <!-- Left: title, contact -->
        <div>
          <h1
            id="bio-heading"
            class="font-display text-foam text-4xl md:text-6xl leading-none tracking-tight mb-4"
          >
            {config.displayName}
          </h1>
          <a
            href={`mailto:${config.email}`}
            class="label-mono text-lg text-ocean-400 hover:text-ocean-200 transition-colors duration-200"
          >
            {config.email}
          </a>
        </div>

        <!-- Right: portrait -->
        <div class="w-32 h-32 md:w-44 md:h-44 flex-shrink-0 rounded-sm overflow-hidden bg-ocean-900 border border-ocean-800 justify-self-end md:justify-self-auto">
          <img
            src={config.portrait}
            alt={`${config.displayName} portrait`}
            class="w-full h-full object-cover opacity-85"
            loading="eager"
            width="176"
            height="176"
            onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
          />
        </div>
      </div>

      <!-- Bio content (injected by parent page, language-toggled) -->
      <div class="border-t border-ocean-900 pt-10 mb-12">
        <p class="label-mono text-lg text-ocean-500 mb-5">Bio</p>
        <div class="lang-en prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio" />
        </div>
        <div class="lang-pt prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio-pt" />
        </div>
        <div class="lang-es prose prose-ocean prose-base md:prose-lg max-w-none">
          <slot name="bio-es" />
        </div>
      </div>

      <!-- Press Kit -->
      <div id="presskit" class="py-10 border-t border-ocean-900">
        <p class="label-mono text-lg text-ocean-500 mb-5">Press Kit</p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <p class="text-ocean-400 text-base">
            <span class="lang-en">Hi-resolution photos, bio, and release info.</span>
            <span class="lang-pt">Fotos em alta resolução, bio e informações de lançamento.</span>
            <span class="lang-es">Fotos en alta resolución, bio e información de lanzamiento.</span>
          </p>
          <a
            href={config.pressKitUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 label-mono text-lg text-foam bg-ocean-800 hover:bg-ocean-700 border border-ocean-700 hover:border-ocean-500 px-5 py-2.5 rounded-sm transition-all duration-200 whitespace-nowrap"
            aria-label="Download press kit (opens Google Drive)"
          >
            Download Press Kit ↓
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Discography ─────────────────────────────────────────────── -->
  <DiscographySection releases={releases} />

  <!-- ── Lyrics / Chords ────────────────────────────────────────── -->
  <section id="lyrics" class="py-16 md:py-24 border-t border-ocean-900" aria-labelledby="lyrics-heading">
    <div class="max-w-4xl mx-auto px-6">
      <p class="label-mono text-lg text-ocean-500 mb-12" id="lyrics-heading">
        <span class="lang-en">Lyrics / Chords</span>
        <span class="lang-pt">Letras / Cifras</span>
        <span class="lang-es">Letras / Cifras</span>
      </p>
      <div class="card-ocean p-10 text-center">
        <p class="text-ocean-500 label-mono text-base">
          <span class="lang-en">Lyrics and chords coming soon.</span>
          <span class="lang-pt">Letras e cifras em breve.</span>
          <span class="lang-es">Letras y cifras próximamente.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ── Videos ─────────────────────────────────────────────────── -->
  <VideosSection project={projectKey} />

</BaseLayout>

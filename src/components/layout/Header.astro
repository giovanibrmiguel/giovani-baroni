---
import { site } from "@/data/site";

const navLinks = [
  { href: "/music", label: "Music" },
  { href: "/projects", label: "Projects" },
  { href: "/blu", label: "bLU" },
  { href: "/about", label: "About" },
  { href: "/press", label: "Press" },
  { href: "/contact", label: "Contact" },
];

const socialLinks = [
  {
    href: site.social.instagram,
    label: "Instagram",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    href: site.social.spotify,
    label: "Spotify",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 11.2c2.8-1.4 6.5-1.4 8.5.2"/><path d="M6.5 14c3.5-1.8 8-1.6 10.5.5"/><path d="M9 17c2.5-1 5.5-1 7.5.5"/></svg>`,
  },
  {
    href: site.social.youtube,
    label: "YouTube",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>`,
  },
  {
    href: site.social.bandcamp,
    label: "Bandcamp",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 18.75l7.437-13.5H24l-7.438 13.5z"/></svg>`,
  },
].filter((l) => l.href && l.href !== "" && !l.href.includes("PLACEHOLDER"));

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div class="backdrop-blur-md bg-ocean-950/85 border-b border-ocean-900/60">
    <nav
      class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-[1fr_auto_1fr] items-center gap-6"
      aria-label="Main navigation"
    >
      <!-- Logo / Artist Name -->
      <a
        href="/"
        class="font-display text-foam text-xl font-semibold tracking-wide hover:text-ocean-200 transition-colors duration-300 justify-self-start"
        aria-label="Giovani Baroni — Home"
      >
        {site.name}
      </a>

      <!-- Desktop Navigation — centered -->
      <ul class="hidden md:flex items-center gap-7 list-none" role="list">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "text-sm font-medium tracking-wide transition-colors duration-200",
                  isActive(href)
                    ? "text-foam"
                    : "text-ocean-300 hover:text-foam",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right side: Social Icons + Mobile Button -->
      <div class="justify-self-end flex items-center gap-4">
        <!-- Social icons — desktop -->
        <div class="hidden md:flex items-center gap-3">
          {
            socialLinks.map(({ href, label, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="text-ocean-400 hover:text-foam transition-colors duration-200"
                set:html={icon}
              />
            ))
          }
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden text-ocean-400 hover:text-foam transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-ocean-900"
      role="navigation"
      aria-label="Mobile navigation"
    >
      <ul class="list-none px-6 py-5 space-y-4" role="list">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "block text-sm font-medium tracking-wide py-1 transition-colors duration-200",
                  isActive(href)
                    ? "text-foam"
                    : "text-ocean-300 hover:text-foam",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <!-- Social icons in mobile menu -->
      <div class="flex items-center gap-4 px-6 pb-5">
        {
          socialLinks.map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="text-ocean-400 hover:text-foam transition-colors duration-200"
              set:html={icon}
            />
          ))
        }
      </div>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-[65px]" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", !isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll("#mobile-menu a").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

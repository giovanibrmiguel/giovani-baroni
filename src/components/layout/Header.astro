---
/**
 * Header / Navigation
 * Minimal, editorial header. Stays at the top of every page.
 * The logo is just the artist name in display type.
 */
import { site } from "@/data/site";

const navLinks = [
  { href: "/music", label: "Music" },
  { href: "/projects", label: "Projects" },
  { href: "/blu", label: "bLU" },
  { href: "/about", label: "About" },
  { href: "/press", label: "Press" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-normal">
  <!-- Subtle top border -->
  <div class="h-px bg-gradient-to-r from-transparent via-ocean-700 to-transparent"></div>

  <div
    class="backdrop-blur-md bg-ocean-950/80 border-b border-ocean-900/50"
  >
    <nav
      class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
      aria-label="Main navigation"
    >
      <!-- Logo / Artist Name -->
      <a
        href="/"
        class="font-display text-foam text-lg tracking-wide hover:text-ocean-200 transition-colors duration-300"
        aria-label="Giovani Baroni — Home"
      >
        {site.name}
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-6 list-none" role="list">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "label-mono text-[11px] transition-colors duration-200",
                  isActive(href)
                    ? "text-foam"
                    : "text-ocean-400 hover:text-ocean-200",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden text-ocean-400 hover:text-foam transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu (hidden by default) -->
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-ocean-900"
      role="navigation"
      aria-label="Mobile navigation"
    >
      <ul class="list-none px-6 py-4 space-y-3" role="list">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "block label-mono text-[11px] py-2 transition-colors duration-200",
                  isActive(href)
                    ? "text-foam"
                    : "text-ocean-400 hover:text-ocean-200",
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<!-- Spacer to prevent content from hiding under the fixed header -->
<div class="h-[57px]" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", !isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  // Close mobile menu on navigation
  document.querySelectorAll("#mobile-menu a").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

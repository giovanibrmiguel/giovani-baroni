---
/**
 * LatestRelease
 * Shows the most recent or featured release on the homepage.
 */
import { releases, featuredReleases } from "@/data/releases";
import ReleaseCard from "@/components/music/ReleaseCard.astro";

// Show the featured release, or the most recent if none is featured
const toShow = featuredReleases[0] ?? releases[0];
---

{
  toShow && (
    <section
      class="py-16 md:py-24 px-6 border-t border-ocean-900"
      aria-labelledby="latest-heading"
    >
      <div class="max-w-6xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <p class="label-mono text-lg text-ocean-500">Latest Release</p>
          <a
            href="/music"
            class="label-mono text-base text-ocean-400 hover:text-ocean-200 transition-colors"
          >
            All releases →
          </a>
        </div>

        <div class="max-w-xs">
          <ReleaseCard release={toShow} />
        </div>
      </div>
    </section>
  )
}

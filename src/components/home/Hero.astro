---
/**
 * Hero Section
 * Full-viewport opening section on the homepage.
 * Features atmospheric gradient background, artist name, and tagline.
 */
import { site } from "@/data/site";
---

<section
  class="relative min-h-[90vh] flex items-center justify-center overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Background gradient layers -->
  <div
    class="absolute inset-0 bg-hero-gradient"
    aria-hidden="true"
  ></div>

  <!-- Animated radial glow — subtle, oceanic -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-[0.07]"
      style="background: radial-gradient(circle, #4a9bb5 0%, transparent 70%);"
    ></div>
    <div
      class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full opacity-[0.04]"
      style="background: radial-gradient(circle, #2d6a4f 0%, transparent 70%);"
    ></div>
  </div>

  <!-- Decorative horizontal lines -->
  <div
    class="absolute inset-0 pointer-events-none overflow-hidden"
    aria-hidden="true"
  >
    <div class="absolute top-1/4 left-0 right-0 h-px bg-ocean-800/40"></div>
    <div class="absolute bottom-1/4 left-0 right-0 h-px bg-ocean-800/30"></div>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Pre-label -->
    <p class="label-mono text-[11px] text-ocean-400 mb-8 animate-fade-in">
      Official Site
    </p>

    <!-- Artist name -->
    <h1
      id="hero-heading"
      class="font-display text-foam text-5xl md:text-7xl lg:text-8xl leading-none tracking-tight mb-6 animate-slide-up"
    >
      {site.name}
    </h1>

    <!-- Tagline -->
    <p
      class="text-ocean-300 text-base md:text-lg font-body font-light tracking-wide max-w-lg mx-auto animate-fade-in"
      style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;"
    >
      {site.tagline}
    </p>

    <!-- Scroll indicator -->
    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40 animate-pulse-slow"
      aria-hidden="true"
    >
      <div class="w-px h-8 bg-ocean-500"></div>
      <span class="label-mono text-[9px] text-ocean-500">scroll</span>
    </div>
  </div>
</section>

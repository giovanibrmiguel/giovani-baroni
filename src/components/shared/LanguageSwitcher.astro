---
/**
 * LanguageSwitcher
 * Toggles bio content between EN, PT, and ES.
 * Stores the selected language in localStorage and sets data-lang on <html>.
 */
---

<div class="flex items-center gap-1 label-mono text-base" aria-label="Language switcher">
  <button
    id="lang-en"
    class="lang-btn px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Switch to English"
  >EN</button>
  <span class="text-ocean-700" aria-hidden="true">·</span>
  <button
    id="lang-pt"
    class="lang-btn px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Mudar para Português"
  >PT</button>
  <span class="text-ocean-700" aria-hidden="true">·</span>
  <button
    id="lang-es"
    class="lang-btn px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Cambiar a Español"
  >ES</button>
</div>

<script>
  const LANGS = ["en", "pt", "es"] as const;
  type Lang = typeof LANGS[number];

  function setLang(lang: Lang) {
    document.documentElement.setAttribute("data-lang", lang);
    localStorage.setItem("lang", lang);
    LANGS.forEach((l) => {
      const btn = document.getElementById(`lang-${l}`);
      if (!btn) return;
      if (l === lang) {
        btn.classList.add("text-foam");
        btn.classList.remove("text-ocean-400");
      } else {
        btn.classList.remove("text-foam");
        btn.classList.add("text-ocean-400");
      }
    });
  }

  // Init on load
  const stored = localStorage.getItem("lang") as Lang | null;
  const browserDefault: Lang = navigator.language.startsWith("pt") ? "pt" : navigator.language.startsWith("es") ? "es" : "en";
  const initial: Lang = stored && LANGS.includes(stored) ? stored : browserDefault;
  setLang(initial);

  LANGS.forEach((l) => {
    document.getElementById(`lang-${l}`)?.addEventListener("click", () => setLang(l));
  });
</script>

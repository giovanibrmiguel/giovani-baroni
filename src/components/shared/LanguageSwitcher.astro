---
/**
 * LanguageSwitcher
 * Toggles bio content between EN, PT, and ES.
 * Stores the selected language in localStorage and sets data-lang on <html>.
 *
 * Uses data-lang-btn attributes instead of IDs so multiple instances
 * (desktop + mobile) all work correctly.
 */
---

<div class="flex items-center gap-0.5 md:gap-1 label-mono text-sm md:text-base" aria-label="Language switcher">
  <button
    data-lang-btn="pt"
    class="lang-btn px-0.5 md:px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Mudar para Português"
  >PT</button>
  <span class="text-ocean-700" aria-hidden="true">·</span>
  <button
    data-lang-btn="en"
    class="lang-btn px-0.5 md:px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Switch to English"
  >EN</button>
  <span class="text-ocean-700" aria-hidden="true">·</span>
  <button
    data-lang-btn="es"
    class="lang-btn px-0.5 md:px-1.5 py-0.5 rounded-sm transition-colors duration-200 text-ocean-400 hover:text-foam"
    aria-label="Cambiar a Español"
  >ES</button>
</div>

<script>
  const LANGS = ["pt", "en", "es"] as const;
  type Lang = typeof LANGS[number];

  function setLang(lang: Lang) {
    document.documentElement.setAttribute("data-lang", lang);
    localStorage.setItem("lang", lang);
    // Update ALL instances of every button (desktop + mobile)
    document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
      if (btn.dataset.langBtn === lang) {
        btn.classList.add("text-foam");
        btn.classList.remove("text-ocean-400");
      } else {
        btn.classList.remove("text-foam");
        btn.classList.add("text-ocean-400");
      }
    });
  }

  // Init on load
  const stored = localStorage.getItem("lang") as Lang | null;
  const browserDefault: Lang = navigator.language.startsWith("es") ? "es" : navigator.language.startsWith("en") ? "en" : "pt";
  const initial: Lang = stored && LANGS.includes(stored) ? stored : browserDefault;
  setLang(initial);

  // Attach listeners to ALL button instances
  document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((btn) => {
    const lang = btn.dataset.langBtn as Lang;
    if (LANGS.includes(lang)) {
      btn.addEventListener("click", () => setLang(lang));
    }
  });
</script>

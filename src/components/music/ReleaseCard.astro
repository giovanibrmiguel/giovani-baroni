---
/**
 * ReleaseCard
 * Displays a single release with cover image, title, type badge,
 * year, short description, and streaming links.
 */
import type { Release } from "@/data/releases";

interface Props {
  release: Release;
  /** Show full description instead of short */
  expanded?: boolean;
}

const { release, expanded = false } = Astro.props;

const hasLinks = Object.values(release.links).some((v) => v && v.length > 0);

const streamingIcons: Record<string, string> = {
  spotify: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`,
  bandcamp: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 18.75l7.437-13.5H24l-7.438 13.5z"/></svg>`,
  youtube: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  appleMusic: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.994 6.124a9.23 9.23 0 0 0-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a6.303 6.303 0 0 0-1.862-.81c-.602-.13-1.223-.17-1.834-.143-.95.04-1.9.238-2.732.71a4.478 4.478 0 0 0-1.81 2.018 4.17 4.17 0 0 0-.36 1.73c-.004.52.07 1.04.22 1.54.38 1.27 1.18 2.27 2.24 2.99a6.14 6.14 0 0 0 1.98.82 6.3 6.3 0 0 0 1.63.12c.55-.04 1.08-.16 1.58-.37l.09-.04v5.87c0 1.47-.43 2.88-1.23 4.09a8.13 8.13 0 0 1-3.32 2.93 8.5 8.5 0 0 1-4.12.83 8.62 8.62 0 0 1-3.94-1.15A8.27 8.27 0 0 1 5.4 19.04a8.16 8.16 0 0 1-1.18-4.15c-.03-1.47.35-2.92 1.1-4.19a8.27 8.27 0 0 1 2.96-2.9 8.57 8.57 0 0 1 4.05-1.1v-2.5a11.08 11.08 0 0 0-5.24 1.43A10.77 10.77 0 0 0 3.1 9.4a10.6 10.6 0 0 0-1.44 5.45c-.04 1.91.46 3.79 1.45 5.43a10.76 10.76 0 0 0 3.86 3.83 10.99 10.99 0 0 0 5.24 1.45 11.12 11.12 0 0 0 5.37-1.08 10.62 10.62 0 0 0 4.32-3.81 10.46 10.46 0 0 0 1.6-5.33V6.124z"/></svg>`,
};
---

<article class="card-ocean overflow-hidden group hover-lift">
  <!-- Cover Image -->
  <div class="aspect-square overflow-hidden bg-ocean-800 relative">
    <img
      src={release.coverImage}
      alt={`${release.title} cover art`}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
      loading="lazy"
      width="400"
      height="400"
      onerror="this.style.display='none'; this.parentElement.querySelector('.placeholder-cover').style.display='flex';"
    />
    <!-- Placeholder shown when image is missing -->
    <div
      class="placeholder-cover hidden absolute inset-0 items-center justify-center bg-ocean-800"
      aria-hidden="true"
    >
      <span class="text-ocean-600 label-mono text-[10px]">cover art</span>
    </div>
    <!-- Type badge -->
    <div class="absolute top-3 left-3">
      <span class="label-mono text-[9px] bg-ocean-950/80 backdrop-blur-sm px-2 py-1 rounded-sm text-ocean-300">
        {release.type.toUpperCase()}
      </span>
    </div>
  </div>

  <!-- Info -->
  <div class="p-4 space-y-2">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-foam text-base leading-tight">{release.title}</h3>
      <span class="label-mono text-[10px] text-ocean-500 shrink-0 pt-0.5">{release.year}</span>
    </div>

    <p class="label-mono text-[10px] text-ocean-400">{release.projectDisplayName}</p>

    <p class="text-ocean-300 text-sm leading-relaxed">
      {expanded ? release.longDescription.split("\n")[0] : release.shortDescription}
    </p>

    <!-- Streaming links -->
    {
      hasLinks && (
        <div class="pt-2 flex flex-wrap gap-2">
          {Object.entries(release.links).map(([platform, url]) =>
            url ? (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 label-mono text-[9px] text-ocean-400 hover:text-ocean-200 border border-ocean-700 hover:border-ocean-500 px-2 py-1 rounded-sm transition-all duration-200"
                aria-label={`Listen on ${platform}`}
              >
                <span set:html={streamingIcons[platform] ?? ""} />
                {platform === "appleMusic" ? "Apple Music" : platform.charAt(0).toUpperCase() + platform.slice(1)}
              </a>
            ) : null
          )}
        </div>
      )
    }
  </div>
</article>

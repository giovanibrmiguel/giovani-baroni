---
/**
 * ProjectCard
 * Displays a summary card for an artistic project.
 * Links to the /projects/[slug] page.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, tagline, coverImage, label } = project.data;
const slug = project.slug;

---

<a
  href={`/projects/${slug}`}
  class:list={[
    "card-ocean block overflow-hidden group hover-lift",
    featured ? "md:flex md:gap-0" : "",
  ]}
  aria-label={`View project: ${title}`}
>
  <!-- Cover Image -->
  <div
    class:list={[
      "overflow-hidden bg-ocean-800 relative",
      featured ? "md:w-1/2 aspect-video md:aspect-auto" : "aspect-video",
    ]}
  >
    <img
      src={coverImage}
      alt={`${title} project image`}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
      loading="lazy"
      width="600"
      height="400"
      onerror="this.style.display='none'; this.parentElement.querySelector('.placeholder-img').style.display='flex';"
    />
    <div
      class="placeholder-img hidden absolute inset-0 items-center justify-center bg-ocean-800 bg-gradient-to-br from-ocean-900 to-ocean-800"
      aria-hidden="true"
    >
      <!-- Decorative placeholder wave -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.5"
        class="text-ocean-700"
        aria-hidden="true"
      >
        <path d="M2 12s4-4 10-4 10 4 10 4-4 4-10 4-10-4-10-4z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </div>

    <!-- Gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-ocean-900/60 to-transparent"
      aria-hidden="true"
    ></div>

  </div>

  <!-- Info -->
  <div
    class:list={[
      "p-5 space-y-2",
      featured ? "md:w-1/2 md:flex md:flex-col md:justify-center md:p-8" : "",
    ]}
  >
    {label && <p class="label-mono text-base text-ocean-500">{label}</p>}
    <h3
      class:list={[
        "font-display text-foam leading-tight",
        featured ? "text-2xl md:text-3xl" : "text-lg",
      ]}
    >
      {title}
    </h3>
    <p class="text-ocean-300 text-sm leading-relaxed">{tagline}</p>

    <p
      class="label-mono text-base text-ocean-400 mt-3 group-hover:text-ocean-200 transition-colors"
    >
      View project →
    </p>
  </div>
</a>

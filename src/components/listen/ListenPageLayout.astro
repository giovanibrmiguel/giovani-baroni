---
/**
 * ListenPageLayout
 * Shared markup + styles for every /listen/<slug> smart-link page. Rendered
 * by src/pages/listen/[slug].astro once per entry in src/data/listenPages.ts.
 *
 * These pages are intentionally bare HTML documents (no Header/Footer/
 * BaseLayout) — they're landing pages for paid/organic ad traffic, meant to
 * load fast and get straight to the streaming links.
 */
import SEO from "@/components/shared/SEO.astro";
import Analytics from "@/components/shared/Analytics.astro";
import MetaPixel from "@/components/shared/MetaPixel.astro";
import CursorPreload from "@/components/shared/CursorPreload.astro";
import GrainOverlay from "@/components/shared/GrainOverlay.astro";
import "@/styles/global.css";
import { releases, type StreamingLinks } from "@/data/releases";
import { site } from "@/data/site";
import { slugByReleaseId, type ListenPageConfig } from "@/data/listenPages";
import { platformIconSvg, PLATFORM_BRAND_COLOR, PLATFORM_FULL_LABEL, type PlatformKey } from "@/data/platformIcons";

interface Props {
  config: ListenPageConfig;
}

const { config } = Astro.props;

const release = releases.find((r) => r.id === config.releaseId);
const isReleased = release?.released ?? false;
const activeLinks: StreamingLinks | undefined = isReleased ? release?.links : release?.preReleaseLinks;
const isFollowPhase = !isReleased && release?.preReleaseCta === "follow";

const PLATFORM_ORDER: PlatformKey[] = ["spotify", "youtube", "appleMusic", "deezer", "youtubeMusic", "amazonMusic"];

const seoTitle = release
  ? isReleased ? `${release.title} — Listen` : `${release.title} — Coming Soon`
  : "Listen";
const seoDescription = release
  ? isReleased
    ? `Stream "${release.title}" by Giovani Baroni on Spotify, Apple Music, YouTube, and more.`
    : `"${release.title}" by Giovani Baroni — coming soon. Follow on your favorite platform.`
  : "Giovani Baroni — listen on your favorite platform.";

const relatedReleases = config.relatedReleaseIds
  .map((id) => {
    const rel = releases.find((r) => r.id === id);
    const slug = slugByReleaseId[id];
    if (!rel || !slug) return null;
    return { release: rel, slug, disabled: config.disabledReleaseIds?.includes(id) ?? false };
  })
  .filter((r) => r !== null);

const moreAboutHref =
  config.moreAbout.kind === "single"
    ? config.moreAbout.withUtm
      ? `${config.releasePagePath}/?utm_source=internal&utm_medium=onsite&utm_content=listen_more_about`
      : config.releasePagePath
    : undefined;

const moreAboutText =
  config.moreAbout.kind === "single"
    ? config.moreAbout.textOverride ?? `leia mais sobre ${release?.title}`
    : undefined;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <CursorPreload />
    <SEO title={seoTitle} description={seoDescription} image={release?.coverImage} noindex={config.noindex} />
    <Analytics />
    <MetaPixel />
  </head>

  <body>
    <GrainOverlay />

    <!-- Ambient blurred cover art as background -->
    {release?.coverImage && (
      <div class="bg-blur" aria-hidden="true">
        <img src={release.coverImage} alt="" />
      </div>
    )}

    <main>
      <div class="wrapper">

        <!-- Cover art — small, centered above everything -->
        {release?.coverImage && (
          <div class="cover-wrap">
            <img
              src={release.coverImage}
              alt={`${release.title} cover art`}
              loading="eager"
            />
          </div>
        )}

        <!-- Artist + title + status — centered, below cover -->
        <p class="artist-label"><a href="/giovani-baroni" class="artist-label-link">GIOVANI BARONI</a></p>
        <h1 class="release-title">
          <a href={config.releasePagePath} class="release-title-link">{release?.title ?? "Coming Soon"}</a>
        </h1>
        <p class="release-meta">
          {isReleased
            ? <span class="badge-out">{config.badgeOutText}</span>
            : release?.releaseDateLabel
              ? <span class="badge-soon">EM BREVE – {release.releaseDateLabel}</span>
              : <span class="badge-soon">Em Breve</span>
          }
        </p>

        <!-- Platform card -->
        <div class="platform-card">

          {release?.preReleaseSubtitle && (
            <p class="pre-note">{release.preReleaseSubtitle}</p>
          )}

          <div class="platform-list">
            {PLATFORM_ORDER.map((key) => {
              const url = activeLinks?.[key];
              if (!config.showAllPlatforms && !url) return null;
              const preCta = isFollowPhase ? (key === "youtube" ? "Subscribe" : "Follow") : "Play";
              const cta = isReleased ? "Play" : preCta;
              const disabled = config.showAllPlatforms && !url;
              return (
                <a
                  href={url ?? "#"}
                  target={url ? "_blank" : undefined}
                  rel={url ? "noopener noreferrer" : undefined}
                  class={`platform-btn${key === "spotify" || key === "youtube" ? "" : " platform-btn-compact"}${disabled ? " platform-btn-disabled" : ""}`}
                  aria-label={`${cta} on ${PLATFORM_FULL_LABEL[key]}`}
                  aria-disabled={disabled ? "true" : undefined}
                  onclick={disabled ? "return false;" : undefined}
                  data-umami-event={url ? "stream_click" : undefined}
                  data-umami-event-platform={url ? key : undefined}
                  data-umami-event-song={url ? release?.id : undefined}
                >
                  <span class="platform-left">
                    <span class="platform-icon" style={`color: ${PLATFORM_BRAND_COLOR[key]};`} set:html={platformIconSvg(key, 20)} />
                    <span class={`platform-name${key === "spotify" || key === "youtube" ? " platform-name-bold" : ""}`}>{PLATFORM_FULL_LABEL[key]}</span>
                  </span>
                  <span class="platform-cta">{cta}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- More about -->
        {config.moreAbout.kind === "trackOfAlbum" ? (
          <p class="more-about-text">
            isso é uma música de <a href="/blu" class="more-about-link">bLU</a>, um álbum conceitual aquático.
            <br />
            <a href={config.releasePagePath} class="more-about-link">leia mais sobre {release?.title}</a>
          </p>
        ) : (
          <a href={moreAboutHref} class="more-about">
            {moreAboutText}
          </a>
        )}

        <!-- More releases -->
        <div class="more-releases">
          <div class="release-cards">
            {relatedReleases.map((item) => item && (
              item.disabled ? (
                <div class="release-card release-card-disabled" aria-disabled="true">
                  <img src={item.release.coverImage} alt={`${item.release.title} cover art`} loading="lazy" />
                  <span class="release-card-title">{item.release.title}</span>
                  <span class="release-card-badge">Em Breve</span>
                </div>
              ) : (
                <a
                  href={`/listen/${item.slug}/?utm_source=internal&utm_medium=onsite&utm_content=related_release_card`}
                  class="release-card"
                  aria-label={`Ir para ${item.release.title}`}
                >
                  <img src={item.release.coverImage} alt={`${item.release.title} cover art`} loading="lazy" />
                  <span class="release-card-title">{item.release.title}</span>
                </a>
              )
            ))}
          </div>
        </div>

        <!-- Instagram -->
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-link"
          aria-label="Follow on Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          @giovanibaroni
        </a>

      </div>
    </main>

    <a href="/privacidade" class="privacy-link">privacidade</a>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    min-height: 100vh;
    background-color: #000d1a;
    color: #dce6ee;
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Ambient background ───────────────────────────────────────────── */
  .bg-blur {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .bg-blur img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
    filter: blur(80px);
    opacity: 0.15;
  }
  .bg-blur::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 13, 26, 0.82);
  }

  /* ── Page layout ──────────────────────────────────────────────────── */
  main {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem;
  }

  .wrapper {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: slideUp 0.45s ease-out both;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Cover art ────────────────────────────────────────────────────── */
  .cover-wrap {
    width: 190px;
    height: 190px;
    flex-shrink: 0;
    overflow: hidden;
    background: #041527;
    margin-bottom: 22px;
    box-shadow:
      0 0 0 1px rgba(6, 32, 64, 0.9),
      0 12px 40px rgba(0, 0, 0, 0.7),
      0 0 60px rgba(0, 13, 26, 0.5);
  }
  .cover-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Artist label ─────────────────────────────────────────────────── */
  .artist-label {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: #b0105b;
    text-transform: uppercase;
    font-weight: 600;
    text-align: center;
    margin-bottom: 8px;
  }
  .artist-label-link {
    color: inherit;
    text-decoration: none;
  }
  .artist-label-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(176, 16, 91, 0.4);
  }

  /* ── Release title ────────────────────────────────────────────────── */
  .release-title {
    font-size: clamp(1.55rem, 5vw, 2rem);
    font-weight: 700;
    color: #c9d0d6;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-align: center;
    margin-bottom: 8px;
  }
  .release-title-link {
    color: inherit;
    text-decoration: none;
  }
  .release-title-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(201, 208, 214, 0.4);
  }

  /* ── Status badge ─────────────────────────────────────────────────── */
  .release-meta {
    text-align: center;
    margin-bottom: 20px;
  }
  .badge-out {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0d5a8c;
    font-weight: 500;
  }
  .badge-soon {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0d5a8c;
    font-weight: 500;
  }

  /* ── Platform card ────────────────────────────────────────────────── */
  .platform-card {
    width: 90%;
    background: #041527;
    border: 1px solid #062040;
    margin-bottom: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .pre-note {
    font-size: 13px;
    color: #0d5a8c;
    font-style: italic;
    text-align: center;
    padding: 14px 18px 0;
    letter-spacing: 0.01em;
  }

  /* ── Platform list ────────────────────────────────────────────────── */
  .platform-list {
    padding: 6px 0;
  }

  .platform-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    text-decoration: none;
    transition: background-color 0.12s, box-shadow 0.12s;
  }
  .platform-btn-compact {
    padding: 11.34px 20px;
  }
  .platform-btn:hover {
    background-color: #062040;
    box-shadow: inset 3px 0 0 0 #BF0449;
  }

  .platform-btn-disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .platform-btn-disabled:hover {
    background-color: transparent;
    box-shadow: none;
  }

  .platform-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .platform-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.9;
    transition: opacity 0.12s;
  }
  .platform-btn:hover .platform-icon { opacity: 1; }

  .platform-name {
    font-size: 15px;
    font-weight: 500;
    color: #c8d4de;
    transition: color 0.12s;
  }
  .platform-btn:hover .platform-name { color: #eef3f8; }

  .platform-name-bold {
    font-weight: 700;
  }

  .platform-cta {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: #b0105b;
    flex-shrink: 0;
    margin-left: 14px;
    transition: color 0.12s;
  }
  .platform-btn:hover .platform-cta { color: #e85fa8; }

  /* ── More about ───────────────────────────────────────────────────── */
  .more-about {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: #4a9bb5;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(74, 155, 181, 0.35);
    transition: color 0.2s, text-decoration-color 0.2s;
    text-align: center;
  }
  .more-about:hover {
    color: #c8d4de;
    text-decoration-color: rgba(200, 212, 222, 0.5);
  }

  .more-about-text {
    font-size: 13px;
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: #5a6a78;
    text-align: center;
  }
  .more-about-link {
    color: #4a9bb5;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(74, 155, 181, 0.35);
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .more-about-link:hover {
    color: #c8d4de;
    text-decoration-color: rgba(200, 212, 222, 0.5);
  }

  /* ── Instagram link ───────────────────────────────────────────────── */
  .instagram-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #5a6a78;
    text-decoration: none;
    transition: color 0.2s;
  }
  .instagram-link:hover {
    color: #c8d4de;
  }

  .privacy-link {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #2c3742;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s, color 0.2s;
  }
  .privacy-link:hover {
    opacity: 1;
    color: #5a6a78;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── More releases ────────────────────────────────────────────────── */
  .more-releases {
    margin-top: 28px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .release-cards {
    display: flex;
    gap: 14px;
    justify-content: center;
  }
  .release-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 92px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .release-card:not(.release-card-disabled):hover {
    transform: translateY(-2px);
  }
  .release-card img {
    width: 76px;
    height: 76px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(6, 32, 64, 0.9), 0 6px 20px rgba(0, 0, 0, 0.5);
  }
  .release-card-title {
    font-size: 11px;
    color: #8fa2b3;
    text-align: center;
    line-height: 1.2;
  }
  .release-card-disabled {
    position: relative;
    cursor: not-allowed;
  }
  .release-card-disabled img {
    filter: grayscale(1);
    opacity: 0.4;
  }
  .release-card-disabled .release-card-title {
    opacity: 0.4;
  }
  .release-card-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background: rgba(0, 13, 26, 0.85);
    color: #8fa2b3;
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 5px;
  }
</style>

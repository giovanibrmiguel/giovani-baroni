---
/**
 * GIOVANI BARONI — /giovani-baroni
 * Project page: bio, press kit, discography (bLU + solo releases), videos.
 */
import ProjectPage from "@/components/project-page/ProjectPage.astro";
import { projects, site } from "@/data/site";
import { getGiovaniBaroniReleases } from "@/data/releases";
import { getLyricsByProject } from "@/data/lyrics";
import { getEntry } from "astro:content";
import JsonLd from "@/components/shared/JsonLd.astro";

const gbLyrics = getLyricsByProject("giovani-baroni");
const lyricsByRelease = gbLyrics.reduce<Record<string, typeof gbLyrics>>((acc, entry) => {
  (acc[entry.release] ??= []).push(entry);
  return acc;
}, {});

const config = projects["giovani-baroni"];
const releases = getGiovaniBaroniReleases();

const aboutPage = await getEntry("pages", "about");
const { Content } = await aboutPage!.render();

const aboutPagePt = await getEntry("pages", "about-pt");
const { Content: ContentPt } = await aboutPagePt!.render();

const aboutPageEs = await getEntry("pages", "about-es");
const { Content: ContentEs } = await aboutPageEs!.render();
---

<ProjectPage
  projectKey="giovani-baroni"
  config={config}
  releases={releases}
  description="Giovani Baroni is a Brazilian multi-instrumentalist and producer based in Mexico City — known for prog-influenced indie rock, conceptual albums, and fronting the São Paulo band sukya || porno."
>
  <div slot="bio">
    <Content />
  </div>
  <div slot="bio-pt">
    <ContentPt />
  </div>
  <div slot="bio-es">
    <ContentEs />
  </div>

  <div slot="lyrics">
    <div class="space-y-10">
      {Object.entries(lyricsByRelease).map(([releaseName, songs]) => (
        <div>
          <p class="label-mono text-base text-ocean-600 mb-4 pb-2 border-b border-ocean-900">{releaseName}</p>
          <ul class="space-y-3">
            {songs.map((song) => (
              <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 py-2 border-b border-ocean-900/50 last:border-0">
                <span class="text-ocean-200 text-sm font-medium">{song.title}</span>
                <div class="flex items-center gap-2 shrink-0">
                  {song.genius && (
                    <a
                      href={song.genius}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 label-mono text-xs text-ocean-400 hover:text-foam border border-ocean-800 hover:border-ocean-600 px-2.5 py-1 rounded-sm transition-all duration-200"
                    >
                      <span class="lang-en">Lyrics</span>
                      <span class="lang-pt">Letra</span>
                      <span class="lang-es">Letra</span>
                      ↗
                    </a>
                  )}
                  {song.cifra && (
                    <a
                      href={song.cifra}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 label-mono text-xs text-ocean-400 hover:text-foam border border-ocean-800 hover:border-ocean-600 px-2.5 py-1 rounded-sm transition-all duration-200"
                    >
                      <span class="lang-en">Chords</span>
                      <span class="lang-pt">Cifra</span>
                      <span class="lang-es">Cifra</span>
                      ↗
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</ProjectPage>

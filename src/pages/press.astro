---
/**
 * PRESS / EPK PAGE — /press
 * Designed for journalists, bloggers, and industry contacts.
 * Content from src/content/pages/press.md
 * Press kit link from src/data/site.ts → pressKitUrl
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getEntry } from "astro:content";
import { site } from "@/data/site";

const pressPage = await getEntry("pages", "press");
const { Content } = await pressPage!.render();
---

<BaseLayout
  title="Press"
  description={`Press information and EPK for ${site.name}. Biography, photos, and streaming links for media and industry contacts.`}
>
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <!-- Page header -->
    <header class="mb-16">
      <p class="label-mono text-[11px] text-ocean-500 mb-4">Media</p>
      <h1 class="font-display text-foam text-4xl md:text-6xl leading-tight">
        Press
      </h1>
      <p class="text-ocean-300 text-base mt-4 max-w-lg">
        For journalists, bloggers, radio programmers, and industry contacts.
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-12 md:gap-16">
      <!-- Main content -->
      <div class="md:col-span-2">
        <div class="prose prose-ocean max-w-none">
          <Content />
        </div>
      </div>

      <!-- Press sidebar -->
      <aside class="space-y-8">
        <!-- Press Kit download -->
        {
          site.pressKitUrl && !site.pressKitUrl.includes("PLACEHOLDER") ? (
            <div class="card-ocean p-5 space-y-3">
              <p class="label-mono text-[10px] text-ocean-500">Press Kit</p>
              <p class="text-ocean-300 text-sm leading-relaxed">
                Hi-resolution photos, logos, and full biography.
              </p>
              <a
                href={site.pressKitUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 label-mono text-[11px] text-foam bg-ocean-800 hover:bg-ocean-700 px-4 py-2 rounded-sm transition-colors duration-200 w-full justify-center"
                aria-label="Download press kit (opens Google Drive)"
              >
                Download Press Kit ↓
              </a>
            </div>
          ) : (
            <div class="card-ocean p-5 space-y-3 border-dashed">
              <p class="label-mono text-[10px] text-ocean-600">Press Kit</p>
              <p class="text-ocean-600 text-xs leading-relaxed">
                Press kit coming soon. Update <code class="text-ocean-500">pressKitUrl</code> in <code class="text-ocean-500">src/data/site.ts</code> to add your Google Drive link.
              </p>
            </div>
          )
        }

        <!-- Contact -->
        <div class="space-y-3">
          <p class="label-mono text-[10px] text-ocean-500">Contact</p>
          <a
            href={`mailto:${site.email}`}
            class="block label-mono text-[11px] text-ocean-400 hover:text-ocean-200 transition-colors"
          >
            {site.email} →
          </a>
        </div>

        <!-- Artist photos preview -->
        <div class="space-y-3">
          <p class="label-mono text-[10px] text-ocean-500">Artist Photos</p>
          <div class="grid grid-cols-2 gap-2">
            {
              [1, 2, 3, 4].map((i) => (
                <div class="aspect-square rounded-sm overflow-hidden bg-ocean-900">
                  <img
                    src={`/images/press/photo-${i}-placeholder.jpg`}
                    alt={`${site.name} press photo ${i}`}
                    class="w-full h-full object-cover opacity-70"
                    loading="lazy"
                    width="200"
                    height="200"
                    onerror="this.style.display='none'; this.parentElement.style.background='#0a1520';"
                  />
                </div>
              ))
            }
          </div>
          <p class="text-ocean-600 text-xs">
            Hi-res versions available in the press kit download.
          </p>
        </div>

        <!-- Streaming links -->
        <div class="space-y-3">
          <p class="label-mono text-[10px] text-ocean-500">Streaming</p>
          <nav aria-label="Streaming platforms">
            <ul class="space-y-2 list-none">
              {
                Object.entries(site.social)
                  .filter(([_, url]) => url && !url.includes("PLACEHOLDER"))
                  .map(([platform, url]) => (
                    <li>
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="label-mono text-[11px] text-ocean-400 hover:text-ocean-200 transition-colors"
                      >
                        {platform.charAt(0).toUpperCase() + platform.slice(1)} ↗
                      </a>
                    </li>
                  ))
              }
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

---
/**
 * LANDING PAGE
 * Minimal portal: choose between GIOVANI BARONI and sukya || porno.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { projects } from "@/data/site";

const gb = projects["giovani-baroni"];
const sukya = projects["sukya-porno"];
---

<BaseLayout
  title="Giovani Baroni"
  description="Official website of Giovani Baroni — Brazilian musician and producer known for prog-influenced indie rock. Fronts São Paulo band sukya || porno. Debut solo album bLU out 2026."
  lang="pt"
>
  <div class="min-h-[calc(100vh-65px)] flex flex-col">

  <!-- Fishy Boy strip -->
  <!-- Links straight to /listen/fishyboy (not /listen) because the /listen
       redirect is a static meta-refresh that drops query strings, which
       would otherwise swallow the utm tag below. -->
  <a
    href="/listen/fishyboy/?utm_source=internal&utm_medium=onsite&utm_content=homepage_strip"
    class="group border-b border-ocean-900 flex items-center justify-center gap-4 py-8
           text-ocean-500 hover:text-ocean-200 transition-colors duration-300"
    aria-label="Fishy Boy — new single"
  >
    <span class="font-mono text-xl md:text-2xl tracking-widest lowercase">fishy boy</span>
    <span class="font-mono text-xl md:text-2xl text-ocean-800 group-hover:text-ocean-500 transition-colors duration-300">·</span>
    <span class="font-mono text-xl md:text-2xl tracking-widest text-ocean-700 group-hover:text-ocean-400 transition-colors duration-300 lowercase">???</span>
    <span class="font-mono text-xl md:text-2xl text-ocean-600 group-hover:text-ocean-300 transition-colors duration-300 ml-1">↗</span>
  </a>

  <div class="flex flex-1 flex-col md:flex-row">

    <!-- GIOVANI BARONI card -->
    <a
      href="/giovani-baroni"
      class="group relative flex-1 flex flex-col items-center justify-center overflow-hidden
             border-b md:border-b-0 md:border-r border-ocean-900
             py-20 md:py-0 cursor-pointer transition-all duration-500
             hover:bg-ocean-900/30"
      aria-label="Enter GIOVANI BARONI"
    >
      <!-- Background portrait -->
      <div
        class="absolute inset-0 opacity-10 group-hover:opacity-20 transition-opacity duration-500"
        aria-hidden="true"
      >
        <img
          src={gb.portrait}
          alt=""
          class="w-full h-full object-cover object-center"
          loading="eager"
          onerror="this.parentElement.style.display='none';"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-transparent to-ocean-950/60" />
      </div>

      <!-- Foreground content -->
      <div class="relative z-10 flex flex-col items-center gap-8 text-center px-8">
        <!-- Portrait circle -->
        <div
          class="w-28 h-28 md:w-36 md:h-36 rounded-full overflow-hidden border border-ocean-700
                 group-hover:border-ocean-400 transition-colors duration-500"
        >
          <img
            src={gb.portrait}
            alt="GIOVANI BARONI"
            class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500"
            loading="eager"
            width="144"
            height="144"
            onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
          />
        </div>

        <div>
          <h2
            class="font-display text-foam text-2xl md:text-3xl lg:text-4xl font-semibold tracking-widest
                   group-hover:text-white transition-colors duration-300"
          >
            GIOVANI BARONI
          </h2>
          <p class="label-mono text-base text-ocean-500 mt-3 group-hover:text-ocean-400 transition-colors duration-300">
             
          </p>
        </div>
      </div>
    </a>

    <!-- sukya || porno card -->
    <a
      href="/sukyaporno"
      class="group relative flex-1 flex flex-col items-center justify-center overflow-hidden
             py-20 md:py-0 cursor-pointer transition-all duration-500
             hover:bg-ocean-900/30"
      aria-label="Enter sukya || porno"
    >
      <!-- Background portrait -->
      <div
        class="absolute inset-0 opacity-10 group-hover:opacity-20 transition-opacity duration-500"
        aria-hidden="true"
      >
        <img
          src={sukya.portrait}
          alt=""
          class="w-full h-full object-cover object-center"
          loading="eager"
          onerror="this.parentElement.style.display='none';"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-transparent to-ocean-950/60" />
      </div>

      <!-- Foreground content -->
      <div class="relative z-10 flex flex-col items-center gap-8 text-center px-8">
        <!-- Portrait circle -->
        <div
          class="w-28 h-28 md:w-36 md:h-36 rounded-full overflow-hidden border border-ocean-700
                 group-hover:border-ocean-400 transition-colors duration-500"
        >
          <img
            src={sukya.portrait}
            alt="sukya || porno"
            class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500"
            loading="eager"
            width="144"
            height="144"
            onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
          />
        </div>

        <div>
          <h2
            class="font-display text-foam text-2xl md:text-3xl lg:text-4xl font-semibold tracking-wide
                   group-hover:text-white transition-colors duration-300"
          >
            sukya || porno
          </h2>
          <p class="label-mono text-base text-ocean-500 mt-3 group-hover:text-ocean-400 transition-colors duration-300">
             
          </p>
        </div>
      </div>
    </a>

  </div>

  </div>
</BaseLayout>

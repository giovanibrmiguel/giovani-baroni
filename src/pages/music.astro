---
/**
 * MUSIC PAGE
 * Displays all releases, grouped by project.
 * Data comes from src/data/releases.ts — add releases there.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ReleaseCard from "@/components/music/ReleaseCard.astro";
import EmbedPlayer from "@/components/music/EmbedPlayer.astro";
import { releases } from "@/data/releases";
import type { Release } from "@/data/releases";

// Group releases by project, sorted by year descending
const projectOrder = ["blu", "sukya-porno", "stop-and-go-station"] as const;

type ProjectSlug = typeof projectOrder[number];

const projectLabels: Record<ProjectSlug, { name: string; category: string }> = {
  "blu": { name: "bLU", category: "Giovani Baroni — Solo" },
  "sukya-porno": { name: "sukya || porno", category: "Bands & Collaborations" },
  "stop-and-go-station": { name: "Stop & Go Station", category: "Giovani Baroni — Solo" },
};

const grouped = projectOrder.reduce(
  (acc, slug) => {
    const projectReleases = releases
      .filter((r) => r.project === slug)
      .sort((a, b) => b.year - a.year);
    if (projectReleases.length > 0) {
      acc[slug] = projectReleases;
    }
    return acc;
  },
  {} as Record<string, Release[]>
);

// Category grouping for section headers
const soloProjects = projectOrder.filter(
  (s) => projectLabels[s].category.includes("Solo") && grouped[s]
);
const bandProjects = projectOrder.filter(
  (s) => projectLabels[s].category.includes("Band") && grouped[s]
);
---

<BaseLayout
  title="Music"
  description="Discography of Giovani Baroni — bLU, sukya || porno, Stop & Go Station."
>
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <!-- Page header -->
    <header class="mb-16 md:mb-24">
      <p class="label-mono text-[11px] text-ocean-500 mb-4">Discography</p>
      <h1 class="font-display text-foam text-4xl md:text-6xl leading-tight">
        Music
      </h1>
    </header>

    <!-- ── Solo Projects ──────────────────────────────────────────── -->
    {
      soloProjects.length > 0 && (
        <section aria-labelledby="solo-heading" class="mb-20">
          <div class="flex items-center gap-4 mb-10">
            <p class="label-mono text-[11px] text-ocean-500" id="solo-heading">
              Giovani Baroni
            </p>
            <div class="flex-1 h-px bg-ocean-800" />
          </div>

          {soloProjects.map((slug) =>
            grouped[slug]?.map((release) => (
              <div class="mb-16">
                <!-- Project name header -->
                <div class="mb-8">
                  <h2 class="font-display text-foam text-2xl md:text-3xl">
                    {projectLabels[slug as ProjectSlug].name}
                  </h2>
                </div>

                <div class="grid md:grid-cols-2 gap-8 items-start">
                  <!-- Release card -->
                  <ReleaseCard release={release} expanded />

                  <!-- Embed player -->
                  <div class="space-y-6">
                    <EmbedPlayer
                      embedCode={release.embedCode}
                      title={release.title}
                    />

                    {release.tracklist && release.tracklist.length > 0 && (
                      <div>
                        <p class="label-mono text-[10px] text-ocean-500 mb-3">
                          Tracklist
                        </p>
                        <ol class="space-y-1">
                          {release.tracklist.map((track) => (
                            <li class="text-ocean-300 text-sm font-mono text-xs">
                              {track}
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}

                    {release.credits && release.credits.length > 0 && (
                      <div>
                        <p class="label-mono text-[10px] text-ocean-500 mb-3">
                          Credits
                        </p>
                        <ul class="space-y-1">
                          {release.credits.map((credit) => (
                            <li class="text-ocean-400 text-xs">{credit}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          )}
        </section>
      )
    }

    <div class="section-divider" />

    <!-- ── Bands & Collaborations ─────────────────────────────────── -->
    {
      bandProjects.length > 0 && (
        <section aria-labelledby="bands-heading" class="mt-20">
          <div class="flex items-center gap-4 mb-10">
            <p class="label-mono text-[11px] text-ocean-500" id="bands-heading">
              Bands & Projects
            </p>
            <div class="flex-1 h-px bg-ocean-800" />
          </div>

          {bandProjects.map((slug) => (
            <div class="mb-16">
              <div class="mb-8">
                <h2 class="font-display text-foam text-2xl md:text-3xl">
                  {projectLabels[slug as ProjectSlug].name}
                </h2>
              </div>

              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {grouped[slug]?.map((release) => (
                  <div class="space-y-4">
                    <ReleaseCard release={release} />
                    <EmbedPlayer
                      embedCode={release.embedCode}
                      title={release.title}
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

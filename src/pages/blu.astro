---
/**
 * bLU FLAGSHIP PAGE — /blu
 *
 * This is the dedicated page for bLU, the featured solo album.
 * It has a special, more atmospheric layout compared to other project pages.
 *
 * Long-form content comes from src/content/pages/blu.md
 * Release/embed data comes from src/data/releases.ts
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import BluWorldFooter from "@/components/project-page/BluWorldFooter.astro";
import BluWorldNav from "@/components/project-page/BluWorldNav.astro";
import EmbedPlayer from "@/components/music/EmbedPlayer.astro";
import VideosSection from "@/components/project-page/VideosSection.astro";
import JsonLd from "@/components/shared/JsonLd.astro";
import Win95Button from "@/components/shared/Win95Button.astro";
import { getEntry } from "astro:content";
import { resolveBluTrackHref } from "@/data/bluWorld";
import { releases } from "@/data/releases";
import { projects, site } from "@/data/site";
import { platformIconSvg, PLATFORM_LABEL, type PlatformKey } from "@/data/platformIcons";

const bluPage = await getEntry("pages", "blu");
const { Content } = await bluPage!.render();

const bluPagePt = await getEntry("pages", "blu-pt");
const { Content: ContentPt } = await bluPagePt!.render();

const bluPageEs = await getEntry("pages", "blu-es");
const { Content: ContentEs } = await bluPageEs!.render();

const bluRelease = releases.find((r) => r.project === "blu");
const gbConfig = projects["giovani-baroni"];

const hasListenEmbed =
  bluRelease?.embedCode &&
  !bluRelease.embedCode.includes("PLACEHOLDER");

const heroBackgroundImage = "/images/press/giovani-water_pic.jpg";

const streamingPlatformKeys: PlatformKey[] = ["spotify", "youtubeMusic", "appleMusic", "amazonMusic", "deezer"];
const streamingPlatforms = streamingPlatformKeys.map((key) => ({
  key,
  ...PLATFORM_LABEL[key],
  icon: platformIconSvg(key, 11),
}));

const bluTracklist = bluRelease?.tracklist ?? [];

const bluSchema = {
  "@context": "https://schema.org",
  "@type": "MusicAlbum",
  name: "bLU",
  url: `${site.domain}/blu`,
  description:
    "Debut solo album by Giovani Baroni. A conceptual 10-track record designed to be heard start to finish — progressive rock, emo, and Brazilian indie filtered through imagery of water, memory, and transformation. Released 2026.",
  albumProductionType: "https://schema.org/StudioAlbum",
  albumReleaseType: "https://schema.org/AlbumRelease",
  datePublished: "2026",
  image: `${site.domain}/images/blu/og-blu.jpeg`,
  genre: ["Progressive Rock", "Indie Rock", "Emo", "Psychedelic Rock"],
  byArtist: {
    "@type": "Person",
    name: "Giovani Baroni",
    url: `${site.domain}/giovani-baroni`,
    sameAs: "https://open.spotify.com/artist/6qme9zfWubX4UWQQV8pVPY",
  },
  ...(bluTracklist.length > 0 && {
    track: bluTracklist.map((name, i) => ({
      "@type": "MusicRecording",
      name,
      position: i + 1,
    })),
  }),
};
---

<BaseLayout
  title="bLU"
  description="bLU is the debut solo album by Giovani Baroni — a 10-track prog and indie rock concept record built around water, memory, and transformation. Out 2026."
  image="/images/blu/og-blu.jpeg"
  type="music.album"
  project="blu"
  lang="pt"
>
  <JsonLd schema={bluSchema} slot="head" />
  <!-- ── Hero section ─────────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden pb-8 md:pb-10"
    aria-labelledby="blu-title"
  >
    <!-- Atmospheric background -->
    <div class="absolute inset-0 bg-blu-gradient" aria-hidden="true"></div>

    <!-- Radial glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-[0.08]"
        style="background: radial-gradient(circle, #4a9bb5 0%, transparent 70%);"
      ></div>
      <div
        class="absolute bottom-0 right-1/4 w-[300px] h-[300px] rounded-full opacity-[0.06]"
        style="background: radial-gradient(circle, #2d6a4f 0%, transparent 70%);"
      ></div>
    </div>

    <!-- Hero background photo -->
    <div
      class="absolute inset-x-0 top-0 h-[48vh] min-h-[280px] max-h-[460px] opacity-40"
      aria-hidden="true"
    >
      <img
        src={heroBackgroundImage}
        alt=""
        class="w-full h-full object-cover object-[center_15%]"
        loading="eager"
        onerror="this.parentElement.style.display='none';"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-ocean-950/80 to-ocean-950/30" />
    </div>

    <!-- Hero text -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 pt-16 md:pt-20 w-full">
      <h1
        id="blu-title"
        class="font-display text-foam text-6xl md:text-8xl lg:text-9xl leading-none"
      >
        bLU
      </h1>
      <p class="text-ocean-300 text-base md:text-xl font-light mt-4 max-w-lg">
        <span class="lang-en">A prog journey through water and memory.</span>
        <span class="lang-pt">Uma jornada prog pela água e memória.</span>
        <span class="lang-es">Un viaje prog a través del agua y la memoria.</span>
      </p>
      {
        bluRelease?.year && (
          <p class="label-mono text-base text-ocean-500 mt-3">
            {bluRelease.type.toUpperCase()} · {bluRelease.year}
          </p>
        )
      }

      <BluWorldNav current="blu" />
    </div>
  </section>

  <!-- ── Main content area ────────────────────────────────────────── -->
  <div class="max-w-6xl mx-auto px-6 pb-24">

    <!-- Listen — Spotify embed section, disabled per request. Uncomment to bring back. -->
    <!-- {
      hasListenEmbed && bluRelease && (
        <section class="py-12 md:py-16 border-b border-ocean-900" aria-label="Listen">
          <div class="max-w-2xl">
            <p class="label-mono text-lg text-ocean-500 mb-6">listen</p>
            <EmbedPlayer
              embedCode={bluRelease.embedCode}
              title="bLU"
            />
          </div>
        </section>
      )
    } -->

    <!-- Stream CTA — full width, prominent -->
    <section class="py-10 border-b border-ocean-900" aria-label="Stream">
      <div class="prose prose-ocean prose-base md:prose-lg max-w-none mb-5">
        <h2 class="mt-0 mb-0">stream</h2>
      </div>
      <a
        href="/listen/blu/?utm_source=internal&utm_medium=onsite&utm_content=project_page_cta"
        class="inline-flex items-center gap-3 label-mono text-base text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-5 py-3 rounded-sm transition-all duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z"/><path d="M12 0C5.376 0 0 5.376 0 12s5.376 12 12 12 12-5.376 12-12S18.624 0 12 0zm0 21.6C6.705 21.6 2.4 17.295 2.4 12S6.705 2.4 12 2.4 21.6 6.705 21.6 12 17.295 21.6 12 21.6z"/></svg>
        listen now!!!
      </a>
    </section>

    <!-- Long-form content from src/content/pages/blu.md -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-20 pt-8 md:pt-10 pb-16 md:pb-24">
      <!-- Main text (language-toggled) -->
      <div class="md:col-span-2">
        <div class="lang-en prose prose-ocean prose-base md:prose-lg max-w-none">
          <Content />
        </div>
        <div class="lang-pt prose prose-ocean prose-base md:prose-lg max-w-none">
          <ContentPt />
        </div>
        <div class="lang-es prose prose-ocean prose-base md:prose-lg max-w-none">
          <ContentEs />
        </div>
      </div>

      <!-- Sidebar: cover, tracklist & credits -->
      <aside class="space-y-10">
        {
          bluRelease?.coverImage && (
            <div class="aspect-square rounded-sm overflow-hidden bg-ocean-900 border border-ocean-800">
              <img
                src={bluRelease.coverImage}
                alt="bLU album cover"
                class="w-full h-full object-cover"
                loading="lazy"
                width="400"
                height="400"
                onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
              />
            </div>
          )
        }

        <!-- Release info summary -->
        {
          bluRelease && (
            <div class="card-ocean p-4 space-y-2">
              <p class="label-mono text-base text-ocean-500 mb-3">the record</p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Project Name</span><br />
                bLU
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Artist</span><br />
                <a href="/giovani-baroni" class="hover:text-foam transition-colors duration-200">Giovani Baroni</a>
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Format</span><br />
                {bluRelease.type.toUpperCase()}
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Year</span><br />
                {bluRelease.year}
              </p>
            </div>
          )
        }
        {
          bluRelease?.tracklist && bluRelease.tracklist.length > 0 && (
            <div>
              <p class="label-mono text-base text-ocean-500 mb-4">tracklist</p>
              <ol class="space-y-2">
                {bluRelease.tracklist.map((track) => {
                  const href = resolveBluTrackHref(track);
                  return (
                    <li
                      class:list={[
                        "text-xs font-mono border-b border-ocean-900 pb-2 last:border-0",
                        href ? "text-ocean-300" : "text-ocean-600",
                      ]}
                    >
                      {href ? (
                        <a
                          href={href}
                          class="group inline-flex items-center gap-2 hover:text-foam transition-colors duration-200"
                        >
                          <span>{track}</span>
                          <span
                            class="text-ocean-600 group-hover:text-ocean-400 transition-colors duration-200"
                            aria-hidden="true"
                          >→</span>
                        </a>
                      ) : (
                        <span>{track}</span>
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          )
        }

        <!-- Singles links -->
        <div>
          <p class="label-mono text-base text-ocean-500 mb-4">singles</p>
          <ul class="space-y-2">
            <li>
              <a
                href="/mecanicadosfluidos"
                class="group flex items-center justify-between text-ocean-300 hover:text-foam text-xs font-mono border-b border-ocean-900 pb-2 transition-colors duration-200"
              >
                <span>Mecânica dos Fluidos</span>
                <span class="text-ocean-600 group-hover:text-ocean-400 transition-colors duration-200">→</span>
              </a>
            </li>
            <li>
              <a
                href="/fishyboy"
                class="group flex items-center justify-between text-ocean-300 hover:text-foam text-xs font-mono border-b border-ocean-900 pb-2 transition-colors duration-200"
              >
                <span>Fishy Boy</span>
                <span class="text-ocean-600 group-hover:text-ocean-400 transition-colors duration-200">→</span>
              </a>
            </li>
          </ul>
        </div>

        {
          bluRelease?.credits && bluRelease.credits.length > 0 && (
            <div>
              <p class="label-mono text-base text-ocean-500 mb-4">credits</p>
              <ul class="space-y-2">
                {bluRelease.credits.map((credit) => (
                  <li class="text-ocean-400 text-xs leading-relaxed" set:html={credit} />
                ))}
              </ul>
            </div>
          )
        }

        <!-- Streaming buttons -->
        <div>
          <p class="label-mono text-base text-ocean-500 mb-3">stream</p>
          <div class="flex flex-wrap gap-2">
            {streamingPlatforms.map(({ key, label, line2, icon }) => {
              const url = bluRelease?.links?.[key as keyof typeof bluRelease.links];
              return url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-2.5 py-1.5 rounded-sm transition-all duration-200"
                >
                  <span set:html={icon} />
                  <span class="flex flex-col leading-[1.1] text-left">
                    <span>{label}</span>
                    {line2 && <span>{line2}</span>}
                  </span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-700 border border-ocean-900 px-2.5 py-1.5 rounded-sm cursor-not-allowed select-none">
                  <span set:html={icon} />
                  <span class="flex flex-col leading-[1.1] text-left">
                    <span>{label}</span>
                    {line2 && <span>{line2}</span>}
                  </span>
                </span>
              );
            })}
            <a
              href="/rei-pele"
              class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-2.5 py-1.5 rounded-sm transition-all duration-200"
            >
              <span>⚽</span>
              <span class="flex flex-col leading-[1.1] text-left">
                <span>Pele</span>
                <span>Music</span>
              </span>
            </a>
          </div>
        </div>

      </aside>
    </div>

    <!-- Press Kit + Contact -->
    <section class="py-12 border-t border-ocean-900" aria-label="Press Kit">
      <p class="label-mono text-lg text-ocean-500 mb-6">press kit</p>
      <div class="flex flex-col gap-4 mb-6">
        <p class="text-ocean-400 text-base">
          <span class="lang-en">Hi-resolution photos, bio, and release info.</span>
          <span class="lang-pt">Fotos em alta resolução, bio e informações de lançamento.</span>
          <span class="lang-es">Fotos en alta resolución, bio e información de lanzamiento.</span>
        </p>
        <Win95Button href={gbConfig.pressKitUrl} target="_blank" ariaLabel="Download press kit (opens Google Drive)">
          download press-kit
        </Win95Button>
      </div>
      <p class="label-mono text-base text-ocean-600">
        Contact: <a href={`mailto:${gbConfig.email}`} class="link-ocean">{gbConfig.email}</a>
      </p>
    </section>

  </div>

  <VideosSection project="blu" />

  <BluWorldFooter current="blu" />
</BaseLayout>

---
/**
 * /listen/blu — Placeholder smart-link page for the "bLU" album.
 *
 * No streaming links are set on the blu-album release yet, so the
 * platform-list simply renders empty until they're added.
 */
import SEO from "@/components/shared/SEO.astro";
import Analytics from "@/components/shared/Analytics.astro";
import CursorPreload from "@/components/shared/CursorPreload.astro";
import GrainOverlay from "@/components/shared/GrainOverlay.astro";
import "@/styles/global.css";
import { releases, type StreamingLinks } from "@/data/releases";
import { site } from "@/data/site";

const release = releases.find((r) => r.id === "blu-album");
const singles = [
  { release: releases.find((r) => r.id === "fishyboy-single"), href: "/listen/fishyboy/?utm_source=internal&utm_medium=onsite&utm_content=related_release_card" },
  { release: releases.find((r) => r.id === "mecanicadosfluidos-single"), href: "/listen/mecanicadosfluidos/?utm_source=internal&utm_medium=onsite&utm_content=related_release_card" },
];
const isReleased = release?.released ?? false;
const activeLinks: StreamingLinks | undefined = isReleased ? release?.links : release?.preReleaseLinks;
const isFollowPhase = !isReleased && release?.preReleaseCta === "follow";

const platforms: Array<{
  key: keyof StreamingLinks;
  label: string;
  releasedCta: string;
  preCta: string;
  iconColor: string;
  icon: string;
}> = [
  {
    key: "spotify",
    label: "Spotify",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Follow" : "Play",
    iconColor: "#1DB954",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`,
  },
  {
    key: "youtube",
    label: "YouTube",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Subscribe" : "Play",
    iconColor: "#FF0000",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    key: "appleMusic",
    label: "Apple Music",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Follow" : "Play",
    iconColor: "#FC3C44",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.801.42.127.856.187 1.293.228.555.053 1.11.06 1.667.06h11.03a12.5 12.5 0 001.57-.1c.822-.106 1.596-.35 2.295-.81a5.046 5.046 0 001.88-2.207c.186-.42.293-.87.37-1.324.113-.675.138-1.358.137-2.04-.002-3.8 0-7.595-.003-11.393zm-6.423 3.99v5.712c0 .417-.058.827-.244 1.206-.29.59-.76.962-1.388 1.14-.35.1-.706.157-1.07.173-.95.045-1.773-.6-1.943-1.536a1.88 1.88 0 011.038-2.022c.323-.16.67-.25 1.018-.324.378-.082.758-.153 1.134-.24.274-.063.457-.23.51-.516a.904.904 0 00.02-.193c0-1.815 0-3.63-.002-5.443a.725.725 0 00-.026-.185c-.04-.15-.15-.243-.304-.234-.16.01-.318.035-.475.066-.76.15-1.52.303-2.28.456l-2.325.47-1.374.278c-.016.003-.032.01-.048.013-.277.077-.377.203-.39.49-.002.042 0 .086 0 .13-.002 2.602 0 5.204-.003 7.805 0 .42-.047.836-.215 1.227-.278.64-.77 1.04-1.434 1.233-.35.1-.71.16-1.075.172-.96.036-1.755-.6-1.92-1.544-.14-.812.23-1.685 1.154-2.075.357-.15.73-.232 1.108-.31.287-.06.575-.116.86-.177.383-.083.583-.323.6-.714v-.15c0-2.96 0-5.922.002-8.882 0-.123.013-.25.042-.37.07-.285.273-.448.546-.518.255-.066.515-.112.774-.165.733-.15 1.466-.296 2.2-.444l2.27-.46c.67-.134 1.34-.27 2.01-.403.22-.043.442-.088.663-.106.31-.025.523.17.554.482.008.073.012.148.012.223.002 1.91.002 3.822 0 5.732z"/></svg>`,
  },
  {
    key: "deezer",
    label: "Deezer",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Follow" : "Play",
    iconColor: "#A238FF",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.944 17.773h4.112v1.217h-4.112zm0-2.79h4.112v1.217h-4.112zm0-2.79h4.112v1.218h-4.112zm0-2.791h4.112v1.218h-4.112zm-5.552 8.371h4.112v1.217h-4.112zm0-2.79h4.112v1.217h-4.112zm0-2.79h4.112v1.218h-4.112zm-5.517 5.58h4.112v1.217H7.875zm0-2.79h4.112v1.217H7.875zM2.357 18.99h4.111v1.217H2.357z"/></svg>`,
  },
  {
    key: "youtubeMusic",
    label: "YouTube Music",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Follow" : "Play",
    iconColor: "#FF0000",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.376 0 0 5.376 0 12s5.376 12 12 12 12-5.376 12-12S18.624 0 12 0zm0 19.104c-3.924 0-7.104-3.18-7.104-7.104S8.076 4.896 12 4.896s7.104 3.18 7.104 7.104-3.18 7.104-7.104 7.104zm0-13.332c-3.432 0-6.228 2.796-6.228 6.228S8.568 18.228 12 18.228s6.228-2.796 6.228-6.228S15.432 5.772 12 5.772zM9.684 15.54V8.46L15.816 12l-6.132 3.54z"/></svg>`,
  },
  {
    key: "amazonMusic",
    label: "Amazon Music",
    releasedCta: "Play",
    preCta: isFollowPhase ? "Follow" : "Play",
    iconColor: "#00A8E1",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.958 10.09c0 1.232.029 2.256-.591 3.351-.502.891-1.301 1.438-2.186 1.438-1.214 0-1.922-.924-1.922-2.292 0-2.692 2.415-3.182 4.7-3.182v.685zm3.186 7.705a.661.661 0 0 1-.748.075c-1.051-.873-1.239-1.279-1.814-2.111-1.734 1.769-2.962 2.299-5.209 2.299-2.66 0-4.731-1.641-4.731-4.925 0-2.565 1.391-4.309 3.37-5.164 1.715-.754 4.11-.891 5.942-1.095v-.41c0-.753.06-1.642-.383-2.294-.385-.579-1.124-.82-1.775-.82-1.205 0-2.277.618-2.54 1.897-.054.285-.261.567-.549.58l-3.064-.33c-.259-.057-.547-.266-.472-.661C6.054 2.567 8.982 1.5 11.61 1.5c1.34 0 3.091.356 4.149 1.372C16.891 4.004 16.8 5.8 16.8 7.753v4.735c0 1.424.591 2.049 1.146 2.819.196.275.238.603-.01.806l-2.792 2.682zm3.581 1.424c.293.235.332.573.039.766-1.285.955-3.305 2.578-5.951 1.726-1.344-.432-2.298-1.247-3.079-2.126-.392-.45.017-.978.498-.768 1.547.664 3.167.905 4.79.542 1.137-.254 2.16-.79 3.703-2.14zm.668 1.707c-.266-.396-1.759-.188-2.43-.094-.204.028-.236-.152-.051-.281 1.191-.836 3.145-.595 3.37-.315.227.283-.06 2.247-1.176 3.185-.172.144-.335.067-.259-.121.252-.629.808-2.038.546-2.374z"/></svg>`,
  },
];

const releasePagePath = `/${release?.project}`;
const seoTitle = release
  ? isReleased ? `${release.title} — Listen` : `${release.title} — Coming Soon`
  : "Listen";
const seoDescription = release
  ? isReleased
    ? `Stream "${release.title}" by Giovani Baroni on Spotify, Apple Music, YouTube, and more.`
    : `"${release.title}" by Giovani Baroni — coming soon. Follow on your favorite platform.`
  : "Giovani Baroni — listen on your favorite platform.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <CursorPreload />
    <SEO title={seoTitle} description={seoDescription} image={release?.coverImage} />
    <Analytics />
  </head>

  <body>
    <GrainOverlay />

    <!-- Ambient blurred cover art as background -->
    {release?.coverImage && (
      <div class="bg-blur" aria-hidden="true">
        <img src={release.coverImage} alt="" />
      </div>
    )}

    <main>
      <div class="wrapper">

        <!-- Cover art — small, centered above everything -->
        {release?.coverImage && (
          <div class="cover-wrap">
            <img
              src={release.coverImage}
              alt={`${release.title} cover art`}
              loading="eager"
            />
          </div>
        )}

        <!-- Artist + title + status — centered, below cover -->
        <p class="artist-label"><a href="/giovani-baroni" class="artist-label-link">GIOVANI BARONI</a></p>
        <h1 class="release-title">
          <a href={releasePagePath} class="release-title-link">{release?.title ?? "Coming Soon"}</a>
        </h1>
        <p class="release-meta">
          {isReleased
            ? <span class="badge-out">JÁ SAIU</span>
            : release?.releaseDateLabel
              ? <span class="badge-soon">EM BREVE – {release.releaseDateLabel}</span>
              : <span class="badge-soon">Em Breve</span>
          }
        </p>

        <!-- Platform card -->
        <div class="platform-card">

          {release?.preReleaseSubtitle && (
            <p class="pre-note">{release.preReleaseSubtitle}</p>
          )}

          <div class="platform-list">
            {platforms.map(({ key, label, releasedCta, preCta, iconColor, icon }) => {
              const url = activeLinks?.[key];
              const cta = isReleased ? releasedCta : preCta;
              return (
                <a
                  href={url ?? "#"}
                  target={url ? "_blank" : undefined}
                  rel={url ? "noopener noreferrer" : undefined}
                  class={`platform-btn${key === "spotify" || key === "youtube" ? "" : " platform-btn-compact"}${url ? "" : " platform-btn-disabled"}`}
                  aria-label={`${cta} on ${label}`}
                  aria-disabled={url ? undefined : "true"}
                  onclick={url ? undefined : "return false;"}
                  data-umami-event={url ? "stream_click" : undefined}
                  data-umami-event-platform={url ? key : undefined}
                  data-umami-event-song={url ? release?.id : undefined}
                >
                  <span class="platform-left">
                    <span class="platform-icon" style={`color: ${iconColor};`} set:html={icon} />
                    <span class={`platform-name${key === "spotify" || key === "youtube" ? " platform-name-bold" : ""}`}>{label}</span>
                  </span>
                  <span class="platform-cta">{cta}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- More about -->
        <a href={releasePagePath} class="more-about">
          leia mais sobre {release?.title}
        </a>

        <!-- More releases -->
        <div class="more-releases">
          <div class="release-cards">
            {singles.map(({ release: s, href }) => s && (
              <a href={href} class="release-card" aria-label={`Ir para ${s.title}`}>
                <img src={s.coverImage} alt={`${s.title} cover art`} loading="lazy" />
                <span class="release-card-title">{s.title}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Instagram -->
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-link"
          aria-label="Follow on Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          @giovanibaroni
        </a>

      </div>
    </main>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    min-height: 100vh;
    background-color: #000d1a;
    color: #dce6ee;
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Ambient background ───────────────────────────────────────────── */
  .bg-blur {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .bg-blur img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
    filter: blur(80px);
    opacity: 0.15;
  }
  .bg-blur::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 13, 26, 0.82);
  }

  /* ── Page layout ──────────────────────────────────────────────────── */
  main {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem;
  }

  .wrapper {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: slideUp 0.45s ease-out both;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Cover art ────────────────────────────────────────────────────── */
  .cover-wrap {
    width: 190px;
    height: 190px;
    flex-shrink: 0;
    overflow: hidden;
    background: #041527;
    margin-bottom: 22px;
    box-shadow:
      0 0 0 1px rgba(6, 32, 64, 0.9),
      0 12px 40px rgba(0, 0, 0, 0.7),
      0 0 60px rgba(0, 13, 26, 0.5);
  }
  .cover-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Artist label ─────────────────────────────────────────────────── */
  .artist-label {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: #b0105b;
    text-transform: uppercase;
    font-weight: 600;
    text-align: center;
    margin-bottom: 8px;
  }
  .artist-label-link {
    color: inherit;
    text-decoration: none;
  }
  .artist-label-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(176, 16, 91, 0.4);
  }

  /* ── Release title ────────────────────────────────────────────────── */
  .release-title {
    font-size: clamp(1.55rem, 5vw, 2rem);
    font-weight: 700;
    color: #c9d0d6;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-align: center;
    margin-bottom: 8px;
  }
  .release-title-link {
    color: inherit;
    text-decoration: none;
  }
  .release-title-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(201, 208, 214, 0.4);
  }

  /* ── Status badge ─────────────────────────────────────────────────── */
  .release-meta {
    text-align: center;
    margin-bottom: 20px;
  }
  .badge-out {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0d5a8c;
    font-weight: 500;
  }
  .badge-soon {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0d5a8c;
    font-weight: 500;
  }

  /* ── Platform card ────────────────────────────────────────────────── */
  .platform-card {
    width: 90%;
    background: #041527;
    border: 1px solid #062040;
    margin-bottom: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .pre-note {
    font-size: 13px;
    color: #0d5a8c;
    font-style: italic;
    text-align: center;
    padding: 14px 18px 0;
    letter-spacing: 0.01em;
  }

  /* ── Platform list ────────────────────────────────────────────────── */
  .platform-list {
    padding: 6px 0;
  }

  .platform-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    text-decoration: none;
    transition: background-color 0.12s, box-shadow 0.12s;
  }
  .platform-btn-compact {
    padding: 11.34px 20px;
  }
  .platform-btn:hover {
    background-color: #062040;
    box-shadow: inset 3px 0 0 0 #BF0449;
  }

  .platform-btn-disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .platform-btn-disabled:hover {
    background-color: transparent;
    box-shadow: none;
  }

  .platform-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .platform-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.9;
    transition: opacity 0.12s;
  }
  .platform-btn:hover .platform-icon { opacity: 1; }

  .platform-name {
    font-size: 15px;
    font-weight: 500;
    color: #c8d4de;
    transition: color 0.12s;
  }
  .platform-btn:hover .platform-name { color: #eef3f8; }

  .platform-name-bold {
    font-weight: 700;
  }

  .platform-cta {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: #b0105b;
    flex-shrink: 0;
    margin-left: 14px;
    transition: color 0.12s;
  }
  .platform-btn:hover .platform-cta { color: #e85fa8; }

  /* ── More about ───────────────────────────────────────────────────── */
  .more-about {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: #4a9bb5;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(74, 155, 181, 0.35);
    transition: color 0.2s, text-decoration-color 0.2s;
    text-align: center;
  }
  .more-about:hover {
    color: #c8d4de;
    text-decoration-color: rgba(200, 212, 222, 0.5);
  }

  /* ── Instagram link ───────────────────────────────────────────────── */
  .instagram-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #5a6a78;
    text-decoration: none;
    transition: color 0.2s;
  }
  .instagram-link:hover {
    color: #c8d4de;
  }

  /* ── More releases ────────────────────────────────────────────────── */
  .more-releases {
    margin-top: 28px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .release-cards {
    display: flex;
    gap: 14px;
    justify-content: center;
  }
  .release-card {

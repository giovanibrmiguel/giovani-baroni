---
/**
 * MECÂNICA DOS FLUIDOS — /mecanicadosfluidos
 *
 * Dedicated page for the first single from bLU.
 * Follows the same atmospheric layout as the bLU page.
 *
 * Long-form content comes from src/content/pages/mecanicadosfluidos.md
 * Release/embed data comes from src/data/releases.ts
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import EmbedPlayer from "@/components/music/EmbedPlayer.astro";
import VideosSection from "@/components/project-page/VideosSection.astro";
import JsonLd from "@/components/shared/JsonLd.astro";
import { getEntry } from "astro:content";
import { releases } from "@/data/releases";
import { projects, site } from "@/data/site";

const mdfPage = await getEntry("pages", "mecanicadosfluidos");
const { Content } = await mdfPage!.render();

const mdfPagePt = await getEntry("pages", "mecanicadosfluidos-pt");
const { Content: ContentPt } = await mdfPagePt!.render();

const mdfPageEs = await getEntry("pages", "mecanicadosfluidos-es");
const { Content: ContentEs } = await mdfPageEs!.render();

const mdfRelease = releases.find((r) => r.project === "mecanicadosfluidos");
const gbConfig = projects["giovani-baroni"];

const hasListenEmbed =
  mdfRelease?.embedCode &&
  !mdfRelease.embedCode.includes("PLACEHOLDER");

const heroBackgroundImage = "/images/mecanicadosfluidos/mecanica_photo__small_no_ border.jpg";

const streamingPlatforms = [
  { key: "spotify",      label: "Spotify",  line2: undefined,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>` },
  { key: "youtubeMusic", label: "YouTube", line2: "Music",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.376 0 0 5.376 0 12s5.376 12 12 12 12-5.376 12-12S18.624 0 12 0zm0 19.104c-3.924 0-7.104-3.18-7.104-7.104S8.076 4.896 12 4.896s7.104 3.18 7.104 7.104-3.18 7.104-7.104 7.104zm0-13.332c-3.432 0-6.228 2.796-6.228 6.228S8.568 18.228 12 18.228s6.228-2.796 6.228-6.228S15.432 5.772 12 5.772zM9.684 15.54V8.46L15.816 12l-6.132 3.54z"/></svg>` },
  { key: "appleMusic",   label: "Apple",   line2: "Music",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.997 6.124c0-.738-.065-1.47-.24-2.19-.317-1.31-1.062-2.31-2.18-3.043A6.733 6.733 0 0 0 19.7.227c-.535-.144-1.09-.2-1.65-.225-.37-.013-.74-.02-1.11-.02L7.06 0C6.57.002 6.08.02 5.59.083a7.26 7.26 0 0 0-1.46.27A6.37 6.37 0 0 0 .453 3.678 9.7 9.7 0 0 0 .09 5.857C.02 6.38 0 6.91 0 7.44v9.12c0 .53.02 1.06.09 1.58.17 1.31.7 2.44 1.56 3.35.86.9 1.96 1.48 3.18 1.73.54.11 1.09.17 1.64.18.37.01.74.02 1.11.02h9.84c.37 0 .74-.01 1.1-.02.55-.01 1.1-.07 1.64-.18 1.22-.25 2.32-.83 3.18-1.73.86-.91 1.39-2.04 1.56-3.35.07-.52.09-1.05.09-1.58V7.44c0-.44-.001-.877-.003-1.316zM8 15V9l8 3-8 3z"/></svg>` },
  { key: "amazonMusic",  label: "Amazon",  line2: "Music",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.958 10.09c0 1.232.029 2.256-.591 3.351-.502.891-1.301 1.438-2.186 1.438-1.214 0-1.922-.924-1.922-2.292 0-2.692 2.415-3.182 4.7-3.182v.685zm3.186 7.705a.661.661 0 0 1-.748.075c-1.051-.873-1.239-1.279-1.814-2.111-1.734 1.769-2.962 2.299-5.209 2.299-2.66 0-4.731-1.641-4.731-4.925 0-2.565 1.391-4.309 3.37-5.164 1.715-.754 4.11-.891 5.942-1.095v-.41c0-.753.06-1.642-.383-2.294-.385-.579-1.124-.82-1.775-.82-1.205 0-2.277.618-2.54 1.897-.054.285-.261.567-.549.58l-3.064-.33c-.259-.057-.547-.266-.472-.661C6.054 2.567 8.982 1.5 11.61 1.5c1.34 0 3.091.356 4.149 1.372C16.891 4.004 16.8 5.8 16.8 7.753v4.735c0 1.424.591 2.049 1.146 2.819.196.275.238.603-.01.806l-2.792 2.682zm3.581 1.424c.293.235.332.573.039.766-1.285.955-3.305 2.578-5.951 1.726-1.344-.432-2.298-1.247-3.079-2.126-.392-.45.017-.978.498-.768 1.547.664 3.167.905 4.79.542 1.137-.254 2.16-.79 3.703-2.14zm.668 1.707c-.266-.396-1.759-.188-2.43-.094-.204.028-.236-.152-.051-.281 1.191-.836 3.145-.595 3.37-.315.227.283-.06 2.247-1.176 3.185-.172.144-.335.067-.259-.121.252-.629.808-2.038.546-2.374z"/></svg>` },
  { key: "deezer",       label: "Deezer",  line2: undefined,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.944 17.773h4.112v1.217h-4.112zm0-2.79h4.112v1.217h-4.112zm0-2.79h4.112v1.218h-4.112zm0-2.791h4.112v1.218h-4.112zm-5.552 8.371h4.112v1.217h-4.112zm0-2.79h4.112v1.217h-4.112zm0-2.79h4.112v1.218h-4.112zm-5.517 5.58h4.112v1.217H7.875zm0-2.79h4.112v1.217H7.875zM2.357 18.99h4.111v1.217H2.357z"/></svg>` },
] as const;

const mdfSchema = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: "Mecânica dos Fluidos",
  url: `${site.domain}/mecanicadosfluidos`,
  description:
    "First single from bLU, Giovani Baroni's debut solo album. A tender two-minute piece of Brazilian alternative rock shaped by shoegaze textures, soft melancholy, and the direct emotional language of Rock Triste.",
  datePublished: "2026",
  image: `${site.domain}/images/mecanicadosfluidos/mecanicadosfluidos.jpg`,
  genre: ["Alternative Rock", "Shoegaze", "Rock Triste", "Brazilian Indie"],
  byArtist: {
    "@type": "Person",
    name: "Giovani Baroni",
    url: `${site.domain}/giovani-baroni`,
    sameAs: "https://open.spotify.com/artist/6qme9zfWubX4UWQQV8pVPY",
  },
  inAlbum: {
    "@type": "MusicAlbum",
    name: "bLU",
    url: `${site.domain}/blu`,
  },
};
---

<BaseLayout
  title="Mecânica dos Fluidos"
  description="First single from bLU by Giovani Baroni — a tender two-minute piece of Brazilian alternative rock shaped by shoegaze textures and soft melancholy. Out 2026."
  image="/images/mecanicadosfluidos/mecanicadosfluidos.jpg"
  type="music.song"
  project="blu"
  lang="pt"
>
  <JsonLd schema={mdfSchema} slot="head" />
  <!-- ── Hero section ─────────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden pb-8 md:pb-10"
    aria-labelledby="mdf-title"
  >
    <!-- Atmospheric background -->
    <div class="absolute inset-0 bg-blu-gradient" aria-hidden="true"></div>

    <!-- Radial glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-[0.08]"
        style="background: radial-gradient(circle, #4a9bb5 0%, transparent 70%);"
      ></div>
      <div
        class="absolute bottom-0 right-1/4 w-[300px] h-[300px] rounded-full opacity-[0.06]"
        style="background: radial-gradient(circle, #2d6a4f 0%, transparent 70%);"
      ></div>
    </div>

    <!-- Hero background photo -->
    <div
      class="absolute inset-x-0 top-0 h-[48vh] min-h-[280px] max-h-[460px] opacity-40"
      aria-hidden="true"
    >
      <img
        src={heroBackgroundImage}
        alt=""
        class="w-full h-full object-cover object-[center_15%]"
        loading="eager"
        onerror="this.parentElement.style.display='none';"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-ocean-950/80 to-ocean-950/30" />
    </div>

    <!-- Hero text -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 pt-16 md:pt-20 w-full">
      <h1
        id="mdf-title"
        class="font-display text-foam text-4xl md:text-6xl lg:text-7xl leading-none"
      >
        Mecânica dos Fluidos
      </h1>
      <p class="text-ocean-300 text-base md:text-xl font-light mt-4 max-w-lg">
        <span class="lang-en">Romantic Shoegaze</span>
        <span class="lang-pt">Shoegaze romântico</span>
        <span class="lang-es">Shoegaze romantico</span>
      </p>
      {
        mdfRelease?.year && (
          <p class="label-mono text-base text-ocean-500 mt-3">
            {mdfRelease.type.toUpperCase()} · {mdfRelease.year}
          </p>
        )
      }
    </div>
  </section>

  <!-- ── Main content area ────────────────────────────────────────── -->
  <div class="max-w-6xl mx-auto px-6 pb-24">

    <!-- Listen — hidden until embedCode is set in releases.ts -->
    {
      hasListenEmbed && mdfRelease && (
        <section class="py-12 md:py-16 border-b border-ocean-900" aria-label="Listen">
          <div class="max-w-2xl">
            <p class="label-mono text-lg text-ocean-500 mb-6">Listen</p>
            <EmbedPlayer
              embedCode={mdfRelease.embedCode}
              title="Mecânica dos Fluidos"
            />
          </div>
        </section>
      )
    }

    <!-- Streaming links -->
    {
      mdfRelease?.links && Object.values(mdfRelease.links).some((v) => v) && (
        <section class="py-10 border-b border-ocean-900" aria-label="Streaming links">
          <p class="label-mono text-lg text-ocean-500 mb-5">Stream & Download</p>
          <div class="flex flex-wrap gap-3">
            {Object.entries(mdfRelease.links).map(([platform, url]) =>
              url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="label-mono text-lg text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-4 py-2 rounded-sm transition-all duration-200"
                >
                  {platform === "appleMusic" ? "Apple Music" : platform.charAt(0).toUpperCase() + platform.slice(1)} →
                </a>
              ) : null
            )}
          </div>
        </section>
      )
    }

    <!-- Long-form content from src/content/pages/mecanicadosfluidos.md -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-20 pt-8 md:pt-10 pb-16 md:pb-24">
      <!-- Main text (language-toggled) -->
      <div class="md:col-span-2">
        <div class="lang-en prose prose-ocean prose-base md:prose-lg max-w-none">
          <Content />
        </div>
        <div class="lang-pt prose prose-ocean prose-base md:prose-lg max-w-none">
          <ContentPt />
        </div>
        <div class="lang-es prose prose-ocean prose-base md:prose-lg max-w-none">
          <ContentEs />
        </div>
      </div>

      <!-- Sidebar: cover & credits -->
      <aside class="space-y-10">
        {
          mdfRelease?.coverImage && (
            <div class="aspect-square rounded-sm overflow-hidden bg-ocean-900 border border-ocean-800">
              <img
                src={mdfRelease.coverImage}
                alt="Mecânica dos Fluidos single cover"
                class="w-full h-full object-cover"
                loading="lazy"
                width="400"
                height="400"
                onerror="this.style.display='none'; this.parentElement.style.background='#0c1e30';"
              />
            </div>
          )
        }

        <!-- Release info summary -->
        {
          mdfRelease && (
            <div class="card-ocean p-4 space-y-2">
              <p class="label-mono text-base text-ocean-500 mb-3">Release Info</p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Title</span><br />
                Mecânica dos Fluidos
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Artist</span><br />
                <a href="/giovani-baroni" class="hover:text-foam transition-colors duration-200">Giovani Baroni</a>
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">From</span><br />
                <a href="/blu" class="hover:text-foam transition-colors duration-200">bLU</a>
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Format</span><br />
                {mdfRelease.type.toUpperCase()}
              </p>
              <p class="text-ocean-300 text-xs">
                <span class="text-ocean-500">Year</span><br />
                {mdfRelease.year}
              </p>
            </div>
          )
        }

        {
          mdfRelease?.credits && mdfRelease.credits.length > 0 && (
            <div>
              <p class="label-mono text-base text-ocean-500 mb-4">Credits</p>
              <ul class="space-y-2">
                {mdfRelease.credits.map((credit) => (
                  <li class="text-ocean-400 text-xs leading-relaxed" set:html={credit} />
                ))}
              </ul>
            </div>
          )
        }

        <!-- Streaming buttons -->
        <div>
          <p class="label-mono text-base text-ocean-500 mb-3">Stream</p>
          <div class="flex flex-wrap gap-2">
            {streamingPlatforms.map(({ key, label, line2, icon }) => {
              const url = mdfRelease?.links?.[key as keyof typeof mdfRelease.links];
              return url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-300 hover:text-foam border border-ocean-700 hover:border-ocean-400 px-2.5 py-1.5 rounded-sm transition-all duration-200"
                >
                  <span set:html={icon} />
                  <span class="flex flex-col leading-[1.1] text-left">
                    <span>{label}</span>
                    {line2 && <span>{line2}</span>}
                  </span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5 label-mono text-xs text-ocean-700 border border-ocean-900 px-2.5 py-1.5 rounded-sm cursor-not-allowed select-none">
                  <span set:html={icon} />
                  <span class="flex flex-col leading-[1.1] text-left">
                    <span>{label}</span>
                    {line2 && <span>{line2}</span>}
                  </span>
                </span>
              );
            })}
          </div>
        </div>

      </aside>
    </div>

    <!-- Press Kit + Contact -->
    <section class="py-12 border-t border-ocean-900" aria-label="Press Kit">
      <p class="label-mono text-lg text-ocean-500 mb-6">Press Kit</p>
      <div class="flex flex-col gap-4 mb-6">
        <p class="text-ocean-400 text-base">
          <span class="lang-en">Hi-resolution photos, bio, and release info.</span>
          <span class="lang-pt">Fotos em alta resolução, bio e informações de lançamento.</span>
          <span class="lang-es">Fotos en alta resolución, bio e información de lanzamiento.</span>
        </p>
        <a
          href={gbConfig.pressKitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 whitespace-nowrap"
          style="background:#c0c0c0; color:#000; font-family:'MS Sans Serif',Arial,sans-serif; font-size:0.8rem; letter-spacing:0.05em; padding:4px 10px; border-top:2px solid #fff; border-left:2px solid #fff; border-right:2px solid #808080; border-bottom:2px solid #808080; cursor:pointer; text-decoration:none; width:fit-content;"
          aria-label="Download press kit (opens Google Drive)"
          onmousedown="this.style.borderTop='2px solid #808080';this.style.borderLeft='2px solid #808080';this.style.borderRight='2px solid #fff';this.style.borderBottom='2px solid #fff';"
          onmouseup="this.style.borderTop='2px solid #fff';this.style.borderLeft='2px solid #fff';this.style.borderRight='2px solid #808080';this.style.borderBottom='2px solid #808080';"
        >
          download press-kit
        </a>
      </div>
      <p class="label-mono text-base text-ocean-600">
        Contact: <a href={`mailto:${gbConfig.email}`} class="link-ocean">{gbConfig.email}</a>
      </p>
    </section>

  </div>

  <VideosSection project="blu" />
</BaseLayout>

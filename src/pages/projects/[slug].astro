---
/**
 * DYNAMIC PROJECT PAGE — /projects/[slug]
 *
 * How Astro generates these pages:
 *   - getStaticPaths() runs at build time
 *   - It reads every .md file in src/content/projects/
 *   - For each file, it creates one page at /projects/[filename-without-extension]
 *   - So src/content/projects/blu.md → /projects/blu
 *
 * To add a new project: just add a new .md file to src/content/projects/
 * No code changes needed.
 */
import { getCollection } from "astro:content";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ReleaseCard from "@/components/music/ReleaseCard.astro";
import EmbedPlayer from "@/components/music/EmbedPlayer.astro";
import { releases } from "@/data/releases";
import type { Release } from "@/data/releases";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

// Get releases associated with this project
const projectReleases = releases
  .filter((r) => r.project === project.slug as Release["project"])
  .sort((a, b) => b.year - a.year);

const { title, tagline, coverImage, label, links, members, seoDescription } = project.data;

// PT/ES content stubs are translation source files, not standalone pages.
// Their canonical equivalents are /sukya and /blu — hide from search engines.
const isTranslationStub = project.slug.endsWith("-pt") || project.slug.endsWith("-es");

const platformIcons: Record<string, string> = {
  spotify: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  youtube: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  bandcamp: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 18.75l7.437-13.5H24l-7.438 13.5z"/></svg>`,
};

---

<BaseLayout
  title={title}
  description={seoDescription ?? tagline}
  image={coverImage}
  noindex={isTranslationStub}
>
  <article class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <!-- Back link -->
    <nav class="mb-12" aria-label="Breadcrumb">
      <a
        href="/projects"
        class="label-mono text-base text-ocean-500 hover:text-ocean-200 transition-colors"
      >
        ← All Projects
      </a>
    </nav>

    <!-- Project header -->
    <header class="grid md:grid-cols-2 gap-12 md:gap-20 items-start mb-20">
      <!-- Text side -->
      <div class="space-y-4">
        {label && <p class="label-mono text-base text-ocean-400">{label}</p>}

        <h1 class="font-display text-foam text-4xl md:text-6xl leading-none">
          {title}
        </h1>

        <p class="text-ocean-200 text-lg font-light leading-relaxed">{tagline}</p>

        {
          members && members.length > 0 && (
            <div>
              <p class="label-mono text-base text-ocean-500 mb-2">Members</p>
              <ul class="space-y-1">
                {members.map((m) => (
                  <li class="text-ocean-300 text-sm">{m}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          links && Object.values(links).some((v) => v) && (
            <div class="flex flex-wrap gap-3 pt-2">
              {Object.entries(links).map(([platform, url]) =>
                url ? (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 label-mono text-base text-ocean-400 hover:text-ocean-200 border border-ocean-700 hover:border-ocean-500 px-3 py-1.5 rounded-sm transition-all duration-200"
                  >
                    {platformIcons[platform] && (
                      <span set:html={platformIcons[platform]} />
                    )}
                    {platform.charAt(0).toUpperCase() + platform.slice(1)} →
                  </a>
                ) : null
              )}
            </div>
          )
        }
      </div>

      <!-- Cover image -->
      <div class="aspect-square rounded-sm overflow-hidden bg-ocean-800">
        <img
          src={coverImage}
          alt={`${title} cover image`}
          class="w-full h-full object-cover opacity-85"
          loading="eager"
          width="600"
          height="600"
          onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg, #0a1520 0%, #0e2a40 100%)';"
        />
      </div>
    </header>

    <!-- Markdown content -->
    <div class="prose prose-ocean max-w-2xl mb-20">
      <Content />
    </div>

    <!-- Releases section -->
    {
      projectReleases.length > 0 && (
        <section aria-labelledby="releases-heading">
          <div class="flex items-center gap-4 mb-8">
            <p class="label-mono text-lg text-ocean-500" id="releases-heading">
              Releases
            </p>
            <div class="flex-1 h-px bg-ocean-800" />
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {projectReleases.map((release) => (
              <div class="space-y-4">
                <ReleaseCard release={release} />
                <EmbedPlayer embedCode={release.embedCode} title={release.title} />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
